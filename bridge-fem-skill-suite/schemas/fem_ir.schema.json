{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solver-Neutral Bridge FEM IR",
  "type": "object",
  "required": [
    "artifactType",
    "schemaVersion",
    "projectId",
    "runId",
    "artifactId",
    "status",
    "gateId",
    "data"
  ],
  "properties": {
    "artifactType": {
      "const": "fem_model_ir"
    },
    "schemaVersion": {
      "type": "string"
    },
    "projectId": {
      "type": "string",
      "pattern": "^PRJ-"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^ART-"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "gateId": {
      "type": "string"
    },
    "inputArtifacts": {
      "type": "array"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptionRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issueRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "required": [
        "unitSystem",
        "coordinateSystems",
        "materials",
        "sections",
        "nodes",
        "elements",
        "boundaryConditions",
        "loadCases",
        "loadCombinations",
        "stages",
        "outputRequests"
      ],
      "properties": {
        "unitSystem": {
          "type": "string"
        },
        "coordinateSystems": {
          "type": "array",
          "minItems": 1
        },
        "materials": {
          "type": "array"
        },
        "sections": {
          "type": "array"
        },
        "nodes": {
          "type": "array",
          "minItems": 1
        },
        "elements": {
          "type": "array",
          "minItems": 1
        },
        "connections": {
          "type": "array"
        },
        "boundaryConditions": {
          "type": "array"
        },
        "initialStates": {
          "type": "array"
        },
        "loadCases": {
          "type": "array",
          "minItems": 1
        },
        "loadCombinations": {
          "type": "array"
        },
        "stages": {
          "type": "array"
        },
        "outputRequests": {
          "type": "array",
          "minItems": 1
        },
        "provenanceMap": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "basis"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptionRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "PASS",
        "PASS_WITH_BOUNDS",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    }
  },
  "additionalProperties": true
}