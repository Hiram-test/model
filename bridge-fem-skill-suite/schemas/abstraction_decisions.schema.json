{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bridge FEM Abstraction Decisions",
  "type": "object",
  "required": [
    "artifactType",
    "schemaVersion",
    "projectId",
    "runId",
    "artifactId",
    "status",
    "gateId",
    "data"
  ],
  "properties": {
    "artifactType": {
      "const": "abstraction_decisions"
    },
    "schemaVersion": {
      "type": "string"
    },
    "projectId": {
      "type": "string",
      "pattern": "^PRJ-"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^ART-"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "gateId": {
      "type": "string"
    },
    "inputArtifacts": {
      "type": "array"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptionRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issueRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "required": [
        "decisions"
      ],
      "properties": {
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "componentGroupId",
              "disposition",
              "representation",
              "effectChannels",
              "validationChecks"
            ],
            "properties": {
              "componentGroupId": {
                "type": "string",
                "pattern": "^CG-"
              },
              "disposition": {
                "enum": [
                  "显式建模",
                  "等效计入",
                  "仅计质量/荷载",
                  "不纳入"
                ]
              },
              "representation": {
                "type": "object"
              },
              "effectChannels": {
                "type": "array",
                "items": {
                  "enum": [
                    "传力",
                    "刚度",
                    "质量",
                    "荷载",
                    "边界",
                    "初始状态",
                    "气动",
                    "局部响应"
                  ]
                }
              },
              "validationChecks": {
                "type": "array",
                "minItems": 1
              },
              "sourceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assumptionRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "basis"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptionRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "PASS",
        "PASS_WITH_BOUNDS",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    }
  },
  "additionalProperties": true
}