{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bridge-fem/schemas/artifact_envelope.schema.json",
  "title": "Bridge FEM Artifact Envelope",
  "type": "object",
  "required": [
    "artifactType",
    "schemaVersion",
    "projectId",
    "runId",
    "artifactId",
    "status",
    "gateId",
    "data"
  ],
  "properties": {
    "artifactType": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^PRJ-"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^ART-"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "gateId": {
      "type": "string",
      "minLength": 1
    },
    "inputArtifacts": {
      "type": "array"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptionRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issueRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object"
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "PASS",
        "PASS_WITH_BOUNDS",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "severity": {
      "enum": [
        "CRITICAL",
        "MAJOR",
        "MINOR",
        "INFO"
      ]
    },
    "quantity": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "basis"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptionRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "originalValue": {},
        "originalUnit": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversionRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^(sha256:)?[a-fA-F0-9]{64}$"
    },
    "sourceRefArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issue": {
      "type": "object",
      "required": [
        "issueId",
        "severity",
        "status",
        "summary"
      ],
      "properties": {
        "issueId": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "status": {
          "enum": [
            "OPEN",
            "CLOSED",
            "ACCEPTED",
            "SUPERSEDED"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 3
        },
        "blocking": {
          "type": "boolean"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
