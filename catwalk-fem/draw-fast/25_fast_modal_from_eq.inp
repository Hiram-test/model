! ========================================================================
! 25_fast_modal_from_eq.inp
! RESUME 平衡库 -> 删跨幅 CE -> 一步保持 -> Lanczos 80。
! 不写 COMBIN14。不加 E20/E21 k。不反标 0.0996。
! ========================================================================
/CLEAR,START
/FILNAME,cw_draw_fast,0
/TITLE,CATWALK DRAWING CROSS-Y CE DELETE FAST MODAL
CW_EQDB='cw_clean_modal_eq'
CW_NMODES=80
/OUTPUT,cw_draw_fast_status,txt
/COM,STATUS=INPUT_STARTED
/OUTPUT
RESUME,%CW_EQDB%,db
/INPUT,21_ce_replace_only,inp
/PREP7
ALLSEL,ALL
*GET,CW_NCOUNT,NODE,0,COUNT
*GET,CW_ECOUNT,ELEM,0,COUNT
/OUTPUT,cw_draw_fast_gate,txt
*VWRITE,CW_NCOUNT,CW_ECOUNT
('NODES=',F12.0,', ELEMS=',F12.0)
/OUTPUT
FINISH
/SOLU
ANTYPE,STATIC,NEW
NLGEOM,ON
PSTRES,ON
STABILIZE,OFF
NROPT,FULL
LNSRCH,ON
PRED,OFF
NEQIT,80
ACEL,0,0,9806
TIME,1.002
KBC,0
AUTOTS,ON
NSUBST,1,20,1
OUTRES,ALL,LAST
RESCONTROL,DEFINE,ALL,LAST
SOLVE
*GET,CW_CNVG,ACTIVE,0,SOLU,CNVG
*IF,CW_CNVG,NE,1,THEN
/OUTPUT,cw_draw_fast_status,txt
/COM,STATUS=REJECTED REASON=ONE_HOLD_NOT_CONVERGED
/OUTPUT
/EXIT,NOSAVE
*ENDIF
SAVE,cw_draw_fast_eq,db
FINISH
/SOLU
ANTYPE,,RESTART,1,,PERTURB
PERTURB,MODAL,AUTO,CURRENT,PARKEEP
SOLVE,ELFORM
/FILNAME,cw_draw_fast,0
LUMPM,OFF
MODOPT,LANB,CW_NMODES
MXPAND,CW_NMODES,,,NO
OUTRES,NSOL,ALL
SOLVE
FINISH
/POST1
FILE,cw_draw_fast,rstp
SET,LAST
*GET,CW_AVAILABLE,ACTIVE,0,SET,NSET
*CFOPEN,cw_draw_fast_frequencies,csv
*DO,CW_I,1,CW_AVAILABLE
SET,1,CW_I
*GET,CW_FREQ,ACTIVE,0,SET,FREQ
*VWRITE,CW_I,CW_FREQ
(F8.0,',',E24.16)
*ENDDO
*CFCLOS
/INPUT,26_ta_classify_post1,inp
/OUTPUT,cw_draw_fast_status,txt
/COM,STATUS=FAST_MODAL_COMPLETED COMPARISON_NOT_PERFORMED
/OUTPUT
FINISH
/EXIT,NOSAVE
