! ========================================================================
! 26_ta_classify_post1.inp
! share_duz>=0.90 且 |f-0.073359|>0.003 记 TA_LIFTED。不写成表4-1 TA1。
! ========================================================================
*DIM,CW_PP,ARRAY,5
*DIM,CW_PM,ARRAY,5
CW_PP(1)=80
CW_PP(2)=28469
CW_PP(3)=28660
CW_PP(4)=374
CW_PP(5)=29176
CW_PM(1)=14098
CW_PM(2)=51317
CW_PM(3)=51508
CW_PM(4)=14392
CW_PM(5)=52024
CW_FLOCK=0.07335932
CW_TA_HIT=0
*CFOPEN,cw_draw_fast_ta_class,csv
*VWRITE
('mode,freq,share_ux,share_uz,share_duz,flag')
*DO,CW_I,1,CW_AVAILABLE
SET,1,CW_I
*GET,CW_FREQ,ACTIVE,0,SET,FREQ
CW_SUX=0
CW_SUZ=0
CW_SDZ=0
*DO,CW_K,1,5
*GET,CW_UXP,NODE,CW_PP(CW_K),U,X
*GET,CW_UZP,NODE,CW_PP(CW_K),U,Z
*GET,CW_UXM,NODE,CW_PM(CW_K),U,X
*GET,CW_UZM,NODE,CW_PM(CW_K),U,Z
CW_UXA=0.5*(CW_UXP+CW_UXM)
CW_UZA=0.5*(CW_UZP+CW_UZM)
CW_DUZ=CW_UZP-CW_UZM
CW_SUX=CW_SUX+CW_UXA*CW_UXA
CW_SUZ=CW_SUZ+CW_UZA*CW_UZA
CW_SDZ=CW_SDZ+CW_DUZ*CW_DUZ
*ENDDO
CW_DEN=CW_SUX+CW_SUZ+CW_SDZ
*IF,CW_DEN,LT,1.0E-30,THEN
CW_DEN=1.0
*ENDIF
CW_SHD=CW_SDZ/CW_DEN
CW_FLAG=0
*IF,CW_SHD,GE,0.90,THEN
*IF,ABS(CW_FREQ-CW_FLOCK),GT,0.003,THEN
CW_FLAG=1
*IF,CW_TA_HIT,EQ,0,THEN
CW_TA_HIT=1
*ENDIF
*ENDIF
*ENDIF
*VWRITE,CW_I,CW_FREQ,CW_SUX,CW_SUZ,CW_SHD,CW_FLAG
(F8.0,',',E16.8,',',F8.4,',',F8.4,',',F8.4,',',F4.0)
*ENDDO
*CFCLOS
