! ========================================================================
! 21_ce_replace_only.inp
! RESUME 之后只删跨幅 CE。禁止 CEDELE,ALL。禁止 CESEL,S。
! 规则：一条 CE 里节点 Y 跨度 >= 15000 mm = 跨幅通道虚焊，删。
! ========================================================================
/PREP7
ALLSEL,ALL
CW_DYCUT=15000
*GET,CW_CEMAX,CE,0,NUM,MAX
*IF,CW_CEMAX,LE,0,THEN
/OUTPUT,cw_draw_fast_ce_delete,txt
/COM,STATUS=REJECTED REASON=NO_CE_IN_DB
/OUTPUT
/EXIT,NOSAVE
*ENDIF
CW_NDEL=0
CW_NKEEP=0
*DO,CW_ICI,1,CW_CEMAX
*GET,CW_NTRM,CE,CW_ICI,NTERM
*IF,CW_NTRM,GT,1,THEN
CW_YMIN=1.0E20
CW_YMAX=-1.0E20
*DO,CW_T,1,CW_NTRM
*GET,CW_ND,CE,CW_ICI,TERM,CW_T,NODE
*IF,CW_ND,GT,0,THEN
CW_YY=NY(CW_ND)
*IF,CW_YY,LT,CW_YMIN,THEN
CW_YMIN=CW_YY
*ENDIF
*IF,CW_YY,GT,CW_YMAX,THEN
CW_YMAX=CW_YY
*ENDIF
*ENDIF
*ENDDO
CW_DY=CW_YMAX-CW_YMIN
*IF,CW_DY,GE,CW_DYCUT,THEN
CEDELE,CW_ICI
CW_NDEL=CW_NDEL+1
*ELSE
CW_NKEEP=CW_NKEEP+1
*ENDIF
*ENDIF
*ENDDO
ALLSEL,ALL
/OUTPUT,cw_draw_fast_ce_delete,txt
*VWRITE,CW_CEMAX,CW_NDEL,CW_NKEEP,CW_DYCUT
('CEMAX=',F12.0,', DELETED=',F12.0,', KEPT=',F12.0,', DYCUT_MM=',F12.1)
/COM,CROSS_Y_CERIG_DELETED SAME_WALKWAY_AND_CABLE_KEPT
/OUTPUT
FINISH
