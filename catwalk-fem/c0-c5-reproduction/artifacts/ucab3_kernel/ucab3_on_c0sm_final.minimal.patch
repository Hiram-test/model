+      subroutine ucab3_validate_properties(prop,indexp) ! UCAB3 contingency validates one frozen cable property block.
+      implicit none ! UCAB3 contingency makes all declarations explicit.
+      integer indexp ! UCAB3 contingency receives the property pointer before the first value.
+      real*8 prop(*),ea,force,mu ! UCAB3 contingency stores EA, frozen tension, and line mass.
+      ea=prop(indexp+1) ! UCAB3 contingency reads the axial rigidity.
+      force=prop(indexp+2) ! UCAB3 contingency reads the frozen tensile force.
+      mu=prop(indexp+3) ! UCAB3 contingency reads the translational line mass.
+      if((ea.ne.ea).or.(force.ne.force).or.(mu.ne.mu)) then ! UCAB3 contingency rejects every NaN constant.
+         write(*,*) '*ERROR UCAB3_PROPERTY_NOT_FINITE' ! UCAB3 contingency emits a stable finite-value failure tag.
+         call exit(201) ! UCAB3 contingency fails closed on a NaN property.
+      endif ! UCAB3 contingency closes the NaN gate.
+      if((dabs(ea).gt.1.d300).or.(dabs(force).gt.1.d300).or. ! UCAB3 contingency rejects unbounded stiffness or tension.
+     &   (dabs(mu).gt.1.d300)) then ! UCAB3 contingency rejects unbounded line mass.
+         write(*,*) '*ERROR UCAB3_PROPERTY_NOT_FINITE' ! UCAB3 contingency emits the shared finite-value failure tag.
+         call exit(201) ! UCAB3 contingency fails closed on an unbounded property.
+      endif ! UCAB3 contingency closes the magnitude gate.
+      if(ea.le.0.d0) then ! UCAB3 contingency requires positive axial rigidity.
+         write(*,*) '*ERROR UCAB3_EA_NOT_POSITIVE',ea ! UCAB3 contingency reports the rejected rigidity.
+         call exit(201) ! UCAB3 contingency fails closed on nonpositive rigidity.
+      endif ! UCAB3 contingency closes the rigidity gate.
+      if(force.lt.0.d0) then ! UCAB3 contingency restricts this cable element to frozen tension.
+         write(*,*) '*ERROR UCAB3_N_NEGATIVE',force ! UCAB3 contingency reports the rejected compression.
+         call exit(201) ! UCAB3 contingency fails closed on cable compression.
+      endif ! UCAB3 contingency closes the frozen-force gate.
+      if(mu.lt.0.d0) then ! UCAB3 contingency permits exactly zero but no negative line mass.
+         write(*,*) '*ERROR UCAB3_MU_NEGATIVE',mu ! UCAB3 contingency reports the rejected line mass.
+         call exit(201) ! UCAB3 contingency fails closed on negative mass.
+      endif ! UCAB3 contingency closes the line-mass gate.
+      return ! UCAB3 contingency returns a validated property block.
+      end ! UCAB3 contingency ends property validation.
+
+      subroutine ucab3_linear_kernel(co,kon,ipkon,nelem,mi,v, ! UCAB3 contingency evaluates exact two-node translational operators.
+     &     prop,ielprop,kmat,mmat,rint,nvec,elen,axial, ! UCAB3 contingency returns stiffness, mass, force, direction, and tension.
+     &     strain,umat,uinit) ! UCAB3 contingency returns generalized strain and energies.
+      implicit none ! UCAB3 contingency makes all declarations explicit.
+      integer kon(*),ipkon(*),nelem,mi(*),ielprop(*) ! UCAB3 contingency receives topology and property pointers.
+      integer node(2),i,j,indexp ! UCAB3 contingency declares endpoint and loop indices.
+      real*8 co(3,*),v(0:mi(2),*),prop(*) ! UCAB3 contingency receives reference geometry and displacement state.
+      real*8 kmat(6,6),mmat(6,6),rint(6),nvec(3) ! UCAB3 contingency returns exact element operators.
+      real*8 dx(3),disp(6),qmat(3,3),elen,ea,force,mu ! UCAB3 contingency stores geometry, state, and constants.
+      real*8 axial,strain,umat,uinit,dotdu,mcoef,delta ! UCAB3 contingency stores reported force, strain, mass scale, and energies.
+      indexp=ielprop(nelem) ! UCAB3 contingency locates the property block.
+      call ucab3_validate_properties(prop,indexp) ! UCAB3 contingency validates EA, tension, and line mass.
+      ea=prop(indexp+1) ! UCAB3 contingency reads axial rigidity.
+      force=prop(indexp+2) ! UCAB3 contingency reads frozen tensile force.
+      mu=prop(indexp+3) ! UCAB3 contingency reads translational line mass.
+      node(1)=kon(ipkon(nelem)+1) ! UCAB3 contingency reads the I endpoint.
+      node(2)=kon(ipkon(nelem)+2) ! UCAB3 contingency reads the J endpoint.
+      elen=0.d0 ! UCAB3 contingency initializes squared reference length.
+      do i=1,3 ! UCAB3 contingency visits each global coordinate.
+         dx(i)=co(i,node(2))-co(i,node(1)) ! UCAB3 contingency forms the reference chord.
+         elen=elen+dx(i)*dx(i) ! UCAB3 contingency accumulates squared chord length.
+      enddo ! UCAB3 contingency completes the chord calculation.
+      elen=dsqrt(elen) ! UCAB3 contingency obtains reference length.
+      if((elen.ne.elen).or.(elen.le.1.d-18)) then ! UCAB3 contingency rejects degenerate geometry.
+         write(*,*) '*ERROR UCAB3_LENGTH_NOT_POSITIVE',nelem,elen ! UCAB3 contingency reports element identity and length.
+         call exit(201) ! UCAB3 contingency fails closed on a degenerate chord.
+      endif ! UCAB3 contingency closes the length gate.
+      do i=1,3 ! UCAB3 contingency normalizes the reference direction.
+         nvec(i)=dx(i)/elen ! UCAB3 contingency stores one direction cosine.
+         disp(i)=v(i,node(1)) ! UCAB3 contingency stores one I-end displacement.
+         disp(i+3)=v(i,node(2)) ! UCAB3 contingency stores one J-end displacement.
+      enddo ! UCAB3 contingency completes direction and state extraction.
+      do i=1,6 ! UCAB3 contingency initializes exact element arrays.
+         rint(i)=0.d0 ! UCAB3 contingency clears one internal-force component.
+         do j=1,6 ! UCAB3 contingency visits one matrix row.
+            kmat(i,j)=0.d0 ! UCAB3 contingency clears one tangent entry.
+            mmat(i,j)=0.d0 ! UCAB3 contingency clears one mass entry.
+         enddo ! UCAB3 contingency completes one matrix row.
+      enddo ! UCAB3 contingency completes operator initialization.
+      do i=1,3 ! UCAB3 contingency assembles the three-by-three endpoint block.
+         do j=1,3 ! UCAB3 contingency visits one global direction pair.
+            delta=0.d0 ! UCAB3 contingency initializes the Kronecker delta.
+            if(i.eq.j) delta=1.d0 ! UCAB3 contingency sets a diagonal delta entry.
+            qmat(i,j)=ea*nvec(i)*nvec(j)/elen+ ! UCAB3 contingency adds exact axial material stiffness.
+     &           force*(delta-nvec(i)*nvec(j))/elen ! UCAB3 contingency adds exact frozen-tension geometric stiffness.
+            kmat(i,j)=qmat(i,j) ! UCAB3 contingency assigns the I-I endpoint block.
+            kmat(i,j+3)=-qmat(i,j) ! UCAB3 contingency assigns the I-J endpoint block.
+            kmat(i+3,j)=-qmat(i,j) ! UCAB3 contingency assigns the J-I endpoint block.
+            kmat(i+3,j+3)=qmat(i,j) ! UCAB3 contingency assigns the J-J endpoint block.
+         enddo ! UCAB3 contingency completes one endpoint-block row.
+      enddo ! UCAB3 contingency completes exact material and geometric stiffness.
+      mcoef=mu*elen/6.d0 ! UCAB3 contingency forms the consistent-mass scale.
+      do i=1,3 ! UCAB3 contingency assembles isotropic translational consistent mass.
+         mmat(i,i)=2.d0*mcoef ! UCAB3 contingency assigns one I-I diagonal mass.
+         mmat(i,i+3)=mcoef ! UCAB3 contingency assigns one I-J coupling mass.
+         mmat(i+3,i)=mcoef ! UCAB3 contingency assigns one J-I coupling mass.
+         mmat(i+3,i+3)=2.d0*mcoef ! UCAB3 contingency assigns one J-J diagonal mass.
+      enddo ! UCAB3 contingency completes consistent translational mass.
+      do i=1,3 ! UCAB3 contingency seeds the exact frozen end tractions.
+         rint(i)=-force*nvec(i) ! UCAB3 contingency assigns the I-end inward internal traction.
+         rint(i+3)=force*nvec(i) ! UCAB3 contingency assigns the J-end inward internal traction.
+      enddo ! UCAB3 contingency completes the frozen-force residual.
+      do i=1,6 ! UCAB3 contingency adds the linearized internal-force increment.
+         do j=1,6 ! UCAB3 contingency contracts the exact tangent with displacement.
+            rint(i)=rint(i)+kmat(i,j)*disp(j) ! UCAB3 contingency adds one incremental force contribution.
+         enddo ! UCAB3 contingency completes one force-row contraction.
+      enddo ! UCAB3 contingency completes the exact small-vibration residual.
+      dotdu=0.d0 ! UCAB3 contingency initializes axial relative displacement.
+      do i=1,3 ! UCAB3 contingency projects relative endpoint displacement.
+         dotdu=dotdu+nvec(i)*(disp(i+3)-disp(i)) ! UCAB3 contingency adds one projected displacement component.
+      enddo ! UCAB3 contingency completes axial projection.
+      strain=dotdu/elen ! UCAB3 contingency reports engineering axial strain.
+      axial=force+ea*strain ! UCAB3 contingency reports frozen plus incremental axial force.
+      umat=0.d0 ! UCAB3 contingency initializes quadratic tangent energy.
+      do i=1,6 ! UCAB3 contingency evaluates one-half d-transpose-K-d.
+         do j=1,6 ! UCAB3 contingency visits one displacement pair.
+            umat=umat+0.5d0*disp(i)*kmat(i,j)*disp(j) ! UCAB3 contingency adds one quadratic-energy term.
+         enddo ! UCAB3 contingency completes one energy row.
+      enddo ! UCAB3 contingency completes tangent energy.
+      uinit=force*dotdu ! UCAB3 contingency reports frozen-force first-order work.
+      return ! UCAB3 contingency returns exact operators and recovered state.
+      end ! UCAB3 contingency ends the linear kernel.
