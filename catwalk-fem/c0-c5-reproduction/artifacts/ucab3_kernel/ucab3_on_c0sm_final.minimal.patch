+      subroutine e_c3d_ucab3(co,kon,lakonl,s,sm,ff,nelem, ! UCAB3 contingency enters exact translational assembly.
+     &     ipkon,mi,vold,prop,ielprop,mass,stiffness, ! UCAB3 contingency receives topology, state, constants, and matrix controls.
+     &     buckling,rhsi,coriolis,iperturb,iexpl,ithermal, ! UCAB3 contingency receives restricted procedure controls.
+     &     bodyfx,nmethod,nope) ! UCAB3 contingency receives acceleration and returns endpoint count.
+      implicit none ! UCAB3 contingency makes all declarations explicit.
+      character*8 lakonl ! UCAB3 contingency receives encoded element metadata.
+      integer kon(*),nelem,ipkon(*),mi(*),ielprop(*),mass(*) ! UCAB3 contingency declares solver integer arrays.
+      integer stiffness,buckling,rhsi,coriolis,iperturb(*) ! UCAB3 contingency declares matrix and procedure controls.
+      integer iexpl,ithermal(*),nmethod,nope,i,j ! UCAB3 contingency declares remaining controls and loops.
+      real*8 co(3,*),s(60,60),sm(60,60),ff(60) ! UCAB3 contingency declares solver-facing element arrays.
+      real*8 vold(0:mi(2),*),prop(*),bodyfx(3) ! UCAB3 contingency receives state, constants, and acceleration.
+      real*8 kmat(6,6),mmat(6,6),rint(6),nvec(3) ! UCAB3 contingency stores exact kernel operators.
+      real*8 elen,axial,strain,umat,uinit ! UCAB3 contingency stores recovered scalar state.
+      nope=2 ! UCAB3 contingency fixes two physical endpoints.
+      if((ichar(lakonl(6:6)).ne.1).or. ! UCAB3 contingency checks the encoded reporting-point count.
+     &   (ichar(lakonl(7:7)).ne.3).or. ! UCAB3 contingency checks the encoded maximum degree.
+     &   (ichar(lakonl(8:8)).ne.2)) then ! UCAB3 contingency checks the encoded endpoint count.
+         write(*,*) '*ERROR UCAB3_ENCODED_METADATA' ! UCAB3 contingency emits a stable metadata failure tag.
+         call exit(201) ! UCAB3 contingency fails closed on corrupt metadata.
+      endif ! UCAB3 contingency closes the encoded-metadata gate.
+      if((nmethod.ne.1).and.(nmethod.ne.2)) then ! UCAB3 contingency permits static and frequency assembly only.
+         write(*,*) '*ERROR UCAB3_NMETHOD',nmethod ! UCAB3 contingency reports the unsupported procedure.
+         call exit(201) ! UCAB3 contingency fails closed on other procedures.
+      endif ! UCAB3 contingency closes the procedure gate.
+      if(nmethod.eq.1) then ! UCAB3 contingency validates static perturbation identity.
+         if(.not.(((iperturb(1).eq.0).and.(iperturb(2).eq.0)).or. ! UCAB3 contingency permits ordinary linear static assembly.
+     &      ((iperturb(1).eq.2).and.(iperturb(2).eq.1)))) then ! UCAB3 contingency permits the measured reference-static flags.
+            write(*,*) '*ERROR UCAB3_STATIC_IPERTURB', ! UCAB3 contingency emits unsupported static flags.
+     &                 iperturb(1),iperturb(2) ! UCAB3 contingency reports the exact flag pair.
+            call exit(201) ! UCAB3 contingency fails closed on an unknown static path.
+         endif ! UCAB3 contingency closes the static flag gate.
+      elseif(nmethod.eq.2) then ! UCAB3 contingency validates frequency perturbation identity.
+         if(.not.(((iperturb(1).eq.0).and.(iperturb(2).eq.0)).or. ! UCAB3 contingency permits an ordinary frequency step.
+     &      ((iperturb(1).eq.1).and.(iperturb(2).eq.0)))) then ! UCAB3 contingency permits preceding-static perturbation frequency.
+            write(*,*) '*ERROR UCAB3_MODAL_IPERTURB', ! UCAB3 contingency emits unsupported modal flags.
+     &                 iperturb(1),iperturb(2) ! UCAB3 contingency reports the exact flag pair.
+            call exit(201) ! UCAB3 contingency fails closed on an unknown modal path.
+         endif ! UCAB3 contingency closes the modal flag gate.
+      endif ! UCAB3 contingency closes procedure-specific validation.
+      if(iexpl.ne.0) then ! UCAB3 contingency rejects explicit integration.
+         write(*,*) '*ERROR UCAB3_EXPLICIT' ! UCAB3 contingency emits a stable explicit-procedure tag.
+         call exit(201) ! UCAB3 contingency fails closed on explicit integration.
+      endif ! UCAB3 contingency closes the explicit gate.
+      if((buckling.ne.0).or.(coriolis.ne.0)) then ! UCAB3 contingency rejects unimplemented operators.
+         write(*,*) '*ERROR UCAB3_PROCEDURE_OPERATOR' ! UCAB3 contingency emits a stable operator failure tag.
+         call exit(201) ! UCAB3 contingency fails closed on buckling or Coriolis assembly.
+      endif ! UCAB3 contingency closes the operator gate.
+      if(ithermal(1).ne.0) then ! UCAB3 contingency rejects thermal coupling.
+         write(*,*) '*ERROR UCAB3_THERMAL' ! UCAB3 contingency emits a stable thermal failure tag.
+         call exit(201) ! UCAB3 contingency fails closed on thermal coupling.
+      endif ! UCAB3 contingency closes the thermal gate.
+      call ucab3_linear_kernel(co,kon,ipkon,nelem,mi,vold, ! UCAB3 contingency calls the shared exact kernel.
+     &     prop,ielprop,kmat,mmat,rint,nvec,elen,axial, ! UCAB3 contingency receives exact operators and recovered force.
+     &     strain,umat,uinit) ! UCAB3 contingency receives strain and energy state.
+      do i=1,6 ! UCAB3 contingency initializes solver-facing vectors and matrices.
+         ff(i)=0.d0 ! UCAB3 contingency clears one consistent load component.
+         do j=1,6 ! UCAB3 contingency visits one matrix row.
+            s(i,j)=0.d0 ! UCAB3 contingency clears one tangent entry.
+            sm(i,j)=0.d0 ! UCAB3 contingency clears one mass entry.
+            if(stiffness.eq.1) s(i,j)=kmat(i,j) ! UCAB3 contingency publishes exact material-plus-geometric tangent.
+            if(mass(1).eq.1) sm(i,j)=mmat(i,j) ! UCAB3 contingency publishes exact consistent translational mass.
+         enddo ! UCAB3 contingency completes one matrix row.
+      enddo ! UCAB3 contingency completes matrix publication.
+      if(rhsi.eq.1) then ! UCAB3 contingency assembles consistent gravity when external loads are requested.
+         do i=1,6 ! UCAB3 contingency visits one endpoint translation.
+            do j=1,3 ! UCAB3 contingency applies the same acceleration at both interpolation nodes.
+               ff(i)=ff(i)+mmat(i,j)*bodyfx(j)+ ! UCAB3 contingency adds the I-end acceleration contribution.
+     &              mmat(i,j+3)*bodyfx(j) ! UCAB3 contingency adds the J-end acceleration contribution.
+            enddo ! UCAB3 contingency completes one consistent load component.
+         enddo ! UCAB3 contingency completes exact gravity loading.
+      endif ! UCAB3 contingency closes consistent-load assembly.
+      return ! UCAB3 contingency returns exact element arrays.
+      end ! UCAB3 contingency ends exact translational assembly.
