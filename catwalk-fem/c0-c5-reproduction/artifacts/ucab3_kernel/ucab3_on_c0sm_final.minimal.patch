+      subroutine resultsmech_ucab3(co,kon,ipkon,v,stx,fn,qa, ! UCAB3 contingency enters exact internal-force recovery.
+     &     mi,ener,eei,eme,iout,nener,calcul_fn,calcul_qa, ! UCAB3 contingency receives output and convergence controls.
+     &     nal,nelem,ielprop,prop) ! UCAB3 contingency receives element and property indices.
+      implicit none ! UCAB3 contingency makes all declarations explicit.
+      integer kon(*),ipkon(*),mi(*),iout,nener ! UCAB3 contingency declares topology and output controls.
+      integer calcul_fn,calcul_qa,nal,nelem,ielprop(*) ! UCAB3 contingency declares force and property controls.
+      integer node(2),i,j ! UCAB3 contingency declares endpoint and component loops.
+      real*8 co(3,*),v(0:mi(2),*),stx(6,mi(1),*) ! UCAB3 contingency receives geometry, state, and resultant storage.
+      real*8 fn(0:mi(2),*),qa(*),ener(2,mi(1),*) ! UCAB3 contingency receives nodal-force, convergence, and energy arrays.
+      real*8 eei(6,mi(1),*),eme(6,mi(1),*),prop(*) ! UCAB3 contingency receives generalized strain and constants.
+      real*8 kmat(6,6),mmat(6,6),rint(6),nvec(3) ! UCAB3 contingency stores exact kernel operators.
+      real*8 elen,axial,strain,umat,uinit,before(3,2) ! UCAB3 contingency stores scalar recovery state and baselines.
+      call ucab3_linear_kernel(co,kon,ipkon,nelem,mi,v, ! UCAB3 contingency calls the shared exact kernel.
+     &     prop,ielprop,kmat,mmat,rint,nvec,elen,axial, ! UCAB3 contingency receives exact operators and force.
+     &     strain,umat,uinit) ! UCAB3 contingency receives strain and energy state.
+      node(1)=kon(ipkon(nelem)+1) ! UCAB3 contingency reads the I endpoint.
+      node(2)=kon(ipkon(nelem)+2) ! UCAB3 contingency reads the J endpoint.
+      before=0.d0 ! UCAB3 contingency initializes convergence-force baselines.
+      if(calcul_qa.eq.1) then ! UCAB3 contingency reads fn only when convergence storage exists.
+         do j=1,2 ! UCAB3 contingency visits both endpoints.
+            do i=1,3 ! UCAB3 contingency visits three translational components.
+               before(i,j)=fn(i,node(j)) ! UCAB3 contingency captures one merged-force baseline.
+            enddo ! UCAB3 contingency completes one endpoint baseline.
+         enddo ! UCAB3 contingency completes both endpoint baselines.
+      endif ! UCAB3 contingency closes guarded baseline access.
+      do i=1,6 ! UCAB3 contingency initializes all reported generalized channels.
+         stx(i,1,nelem)=0.d0 ! UCAB3 contingency clears one reported resultant channel.
+         eme(i,1,nelem)=0.d0 ! UCAB3 contingency clears one material generalized-strain channel.
+         if(iout.gt.0) eei(i,1,nelem)=0.d0 ! UCAB3 contingency clears one output strain channel when allocated.
+      enddo ! UCAB3 contingency completes generalized output initialization.
+      stx(1,1,nelem)=axial ! UCAB3 contingency reports frozen plus incremental axial force in channel one.
+      eme(1,1,nelem)=strain ! UCAB3 contingency reports engineering axial strain in channel one.
+      if(iout.gt.0) eei(1,1,nelem)=strain ! UCAB3 contingency publishes engineering strain for output frames.
+      if(nener.eq.1) then ! UCAB3 contingency writes standard energy only when requested.
+         ener(1,1,nelem)=umat ! UCAB3 contingency stores quadratic tangent energy.
+         ener(2,1,nelem)=uinit ! UCAB3 contingency stores frozen-force first-order work.
+      endif ! UCAB3 contingency closes guarded energy output.
+      if(calcul_fn.eq.1) then ! UCAB3 contingency publishes exact endpoint internal forces.
+         do j=1,2 ! UCAB3 contingency visits both endpoints.
+            do i=1,3 ! UCAB3 contingency visits three translational components.
+               fn(i,node(j))=fn(i,node(j))+rint((j-1)*3+i) ! UCAB3 contingency merges one exact internal-force component.
+            enddo ! UCAB3 contingency completes one endpoint force vector.
+         enddo ! UCAB3 contingency completes both endpoint force vectors.
+      endif ! UCAB3 contingency closes internal-force publication.
+      if(calcul_qa.eq.1) then ! UCAB3 contingency contributes a convergence force measure.
+         do j=1,2 ! UCAB3 contingency visits both endpoints for convergence accounting.
+            do i=1,3 ! UCAB3 contingency visits each translational component.
+               qa(1)=qa(1)+dabs(fn(i,node(j))-before(i,j)) ! UCAB3 contingency adds one force magnitude.
+            enddo ! UCAB3 contingency completes one endpoint contribution.
+         enddo ! UCAB3 contingency completes both endpoint contributions.
+         nal=nal+6 ! UCAB3 contingency records six translational force contributions.
+      endif ! UCAB3 contingency closes convergence accounting.
+      return ! UCAB3 contingency returns recovered state.
+      end ! UCAB3 contingency ends exact internal-force recovery.
