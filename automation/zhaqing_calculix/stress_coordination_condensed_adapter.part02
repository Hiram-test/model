                if len(connectivity) != 4:  # Require the verified four-node shell topology.
                    raise RuntimeError(f"unexpected shell connectivity for gravity mass: {connectivity}")  # Stop before undercounting external gravity.
                p1, p2, p3, p4 = (nodes[node] for node in connectivity)  # Recover the four shell corner coordinates.
                area = triangle_area(p1, p2, p3) + triangle_area(p1, p3, p4)  # Split the quadrilateral into two deterministic triangles.
                mass += density * measure * area  # Add the shell mass from density, thickness, and geometric area.
        mass_by_group[group_name] = mass  # Preserve the component mass for the final load audit.
    gravity_weight = sum(mass_by_group.values()) * GRAVITY_MM_S2  # Convert the complete E_GRAV structural mass to downward gravitational force.
    if "*CLOAD\n" not in text:  # Require the verified permanent nodal-load block.
        raise RuntimeError("coordinated detailed model CLOAD block not found")  # Stop before publishing an incomplete external-load reference.
    cload_text = text.split("*CLOAD\n", 1)[1].split("*NODE PRINT", 1)[0]  # Isolate the final permanent nodal loads before result requests.
    cload_sum = [0.0, 0.0, 0.0]  # Accumulate all explicit CLOAD components in global axes.
    for raw in cload_text.splitlines():  # Parse every explicit permanent nodal-load record.
        line = raw.strip()  # Normalize surrounding whitespace only.
        if not line or line.startswith("**") or line.startswith("*"):  # Ignore empty rows, comments, and subsequent keywords.
            continue  # Advance to the next possible load record.
        fields = [field.strip() for field in line.split(",")]  # Split the standard node,dof,value CLOAD row.
        if len(fields) >= 3 and fields[0].isdigit() and fields[1].isdigit():  # Accept only numeric CLOAD records.
            dof = int(fields[1])  # Recover the global translational load direction.
            if 1 <= dof <= 3:  # Restrict the resultant to translational force components.
                cload_sum[dof - 1] += float(fields[2])  # Add the explicit force value to the global resultant.
    external = (cload_sum[0], cload_sum[1], cload_sum[2] - gravity_weight)  # Combine explicit nodal loads with downward structural gravity.
    audit = {"structuralGravityMassTonne": sum(mass_by_group.values()), "structuralGravityWeightN": gravity_weight, "explicitCloadFxN": cload_sum[0], "explicitCloadFyN": cload_sum[1], "explicitCloadFzN": cload_sum[2], **{f"mass_{name}_tonne": value for name, value in mass_by_group.items()}}  # Preserve full external-load accounting by source component.
    return external, audit

def parse_nsets(text: str) -> dict[str, set[int]]:  # Parse explicit node sets required for support-reaction screening from the coordinated detailed deck.
    sets: dict[str, set[int]] = {}  # Store every explicit NSET by normalized uppercase name.
    active: str | None = None  # Track the current explicit node-set definition while scanning the deck.
    for raw in text.splitlines():  # Visit every input row once in source order.
        line = raw.strip()  # Normalize surrounding whitespace for keyword recognition.
        if line.upper().startswith("*NSET"):  # Detect an explicit node-set definition.
            match = re.search(r"NSET=([^,\s]+)", line, re.I)  # Extract the named set identifier.
            active = match.group(1).upper() if match else None  # Normalize the active set name for deterministic lookup.
            if active:  # Initialize storage only when a valid set name was found.
                sets.setdefault(active, set())  # Preserve continued set definitions without discarding earlier members.
            continue  # Advance to set member rows.
        if line.startswith("*"):  # Detect the next keyword boundary.
            active = None  # Leave explicit node-set parsing mode.
            continue  # Advance to data under the new keyword.
        if active and line and not line.startswith("**"):  # Parse numeric node labels inside the active explicit set.
            for token in line.split(","):  # Visit each comma-separated set member token.
                token = token.strip()  # Normalize surrounding whitespace around the candidate node id.
                if token.isdigit():  # Preserve only explicit integer node labels used by this verified model.
                    sets[active].add(int(token))  # Add the source node id to the normalized set.
    return sets

def evaluate_final_gate(fine_deck_text: str, nodes: dict[int, tuple[float, float, float]], groups: dict[str, list[tuple[int, list[int]]]], solver_exit: int, solver_log: str, displacements: dict[int, tuple[float, float, float]], reactions: dict[int, tuple[float, float, float]], stresses: dict[int, tuple[float, float, float, float, float, float]], target_axial_stress: dict[int, float], equilibrium_state: dict, vtk_receipt: dict) -> dict:  # Apply the P4 numerical acceptance Gate independently of artifact upload success.
    fatal_hits = [token for token in FATAL_TOKENS if token in solver_log.upper()]  # Detect all known fatal, singularity, and MPC-dependence diagnostics.
    solver_nodes, solver_groups, _solver_ownership = parse_model(fine_deck_text)  # Parse the active retained P3 solver topology independently from the full P2 visualization topology.
    nsets = parse_nsets(fine_deck_text)  # Recover the frozen physical support sets from the exact coordinated solver deck.
    support_names = ("TOWER_BASES", "WIND_ANCHORS", "DECK_LEFT_PIN", "DECK_RIGHT_ROLLER")  # Freeze the active P3 physical support contract after suspension-only cable-anchor nodes are condensed out of the detailed solver.
    support_nodes = set().union(*(nsets.get(name, set()) for name in support_names))  # Form one unique set of physical support nodes without double counting.
    reaction_sum = tuple(sum(reactions.get(node, (0.0, 0.0, 0.0))[index] for node in support_nodes) for index in range(3)) if support_nodes else (0.0, 0.0, 0.0)  # Sum only physical-support nodal forces from the perturbation result.
    external_resultant, external_audit = permanent_external_resultant(fine_deck_text, nodes, solver_groups)  # Recover the exact retained-model gravity plus original CLOAD plus transferred suspension-interface force resultant.
    reference_weight = max(abs(external_resultant[2]), 1.0)  # Use the exact total downward permanent resultant as the P4 normalization scale.
    vertical_balance_same_sign = abs(reaction_sum[2] - external_resultant[2]) / reference_weight  # Compare support output to external load under the CalculiX structural-action sign convention.
    vertical_balance_opposite_sign = abs(reaction_sum[2] + external_resultant[2]) / reference_weight  # Also evaluate the conventional support-reaction sign convention explicitly.
    vertical_balance_relative = min(vertical_balance_same_sign, vertical_balance_opposite_sign)  # Remove only sign-convention ambiguity while preserving force-magnitude closure.
    residual_resultant = (reaction_sum[0] - external_resultant[0], reaction_sum[1] - external_resultant[1], reaction_sum[2] - external_resultant[2] if vertical_balance_same_sign <= vertical_balance_opposite_sign else reaction_sum[2] + external_resultant[2])  # Report the force-residual vector using the sign convention that closes the vertical component best.
    tension_checks: list[float] = []  # Collect coordinated total final axial stresses for all main cables and hangers.
    coordination_errors: list[float] = []  # Collect relative final-to-P2-target axial stress deviations for suspension elements.
