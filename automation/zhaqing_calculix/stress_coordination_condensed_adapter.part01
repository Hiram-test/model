

def suspension_element_tangent(element_id: int, element_states: dict[int, dict], coordinated_nodes: dict[int, tuple[float, float, float]]) -> tuple[list[list[float]], tuple[float, float, float]]:  # Build one physical three-dimensional initial-stress axial tangent at the P2 equilibrium state.
    record = element_states[element_id]  # Recover the unique persisted constitutive state for this suspension element.
    node_a, node_b = (int(value) for value in record["nodeIds"])  # Recover its ordered source endpoints.
    point_a = coordinated_nodes[node_a]  # Read the digest-verified equilibrium coordinate at endpoint A.
    point_b = coordinated_nodes[node_b]  # Read the digest-verified equilibrium coordinate at endpoint B.
    length = vector_length(point_a, point_b)  # Recompute the physical equilibrium chord length.
    unit = tuple((point_b[axis] - point_a[axis]) / length for axis in range(3))  # Normalize the global element direction.
    material_tangent = float(record["materialTangentNPerMm"])  # Recover EA/L from the v3 constitutive contract.
    geometric_tangent = float(record["geometricTangentNPerMm"])  # Recover N0/L from the positive P2 initial-force state.
    tangent = zero_matrix(3, 3)  # Allocate the global translational tangent block in N/mm.
    for row in range(3):  # Assemble each global tangent row.
        for column in range(3):  # Assemble material and prestress-geometric contributions in each direction pair.
            axial_projection = unit[row] * unit[column]  # Compute the dyadic axial projector n times n-transpose.
            transverse_projection = (1.0 if row == column else 0.0) - axial_projection  # Compute the orthogonal projector carrying stress stiffness.
            tangent[row][column] = material_tangent * axial_projection + geometric_tangent * transverse_projection  # Form EA/L nn-transpose plus N0/L times the transverse projector.
    return tangent, unit  # Return the positive axial tangent block and equilibrium direction.


def add_vector(target: dict[int, list[float]], node: int, vector: tuple[float, float, float]) -> None:  # Accumulate one physical nodal action vector without synthesizing absent components.
    destination = target.setdefault(node, [0.0, 0.0, 0.0])  # Initialize this exact source node on first contribution.
    for axis in range(3):  # Resolve all three Cartesian components independently.
        destination[axis] += vector[axis]  # Add the requested physical action component.


def vector_norm(vector: list[float] | tuple[float, ...]) -> float:  # Evaluate one Euclidean residual or response magnitude.
    return math.sqrt(sum(value * value for value in vector))  # Return the square root of the Cartesian sum of squares.


def published_plane_for_sign(state: dict, sign: int) -> dict:  # Recover the unique persisted plane state matching one transverse sign.
    plane_id = "POSITIVE_Y" if sign > 0 else "NEGATIVE_Y"  # Map the physical transverse sign to the explicit v3 construction-stage plane identity.
    record = state.get("planeStates", {}).get(plane_id)  # Recover the accepted nominal-F3 plane without relying on numeric JSON-key formatting.
    if not isinstance(record, dict) or not isinstance(record.get("equilibriumAudit"), dict):  # Require one complete v3 equilibrium audit on the requested side.
        raise RuntimeError(f"equilibrium-state v3 is missing audited plane {plane_id}")  # Stop before joining, copying, or omitting a physical plane.
    audit = record["equilibriumAudit"]  # Recover source-keyed interface and support actions from the nominal-F3 vector audit.
    interface_actions = {str(node): [float(value) for value in vector] for node, vector in audit["deckInterfaceActionsOnDeckN"].items()}  # Start with net suspension actions, including the bottom half-weight convention, at every deck interface.
    anchor_actions: dict[str, list[float]] = {}  # Separate fixed cable-anchor actions from retained tower-saddle interfaces.
    for role, support in audit["supportReactions"].items():  # Visit both anchors and both saddle interfaces published for this plane.
        node_key = str(int(support["nodeId"]))  # Normalize the physical source node identity.
        action = [float(value) for value in support["suspensionActionOnSupportN"]]  # Recover the suspension-system action including local half self-weight.
        if "anchor" in role.lower():  # Route fixed cable endpoints to analytic support-reaction recovery.
            anchor_actions[node_key] = action  # Preserve the physical suspension action on this anchor.
        else:  # Route both tower saddles to the retained CalculiX interface.
            interface_actions[node_key] = action  # Preserve the physical suspension action on the retained tower support.
    return {"interfaceActionsN": interface_actions, "anchorActionsN": anchor_actions}  # Return the normalized v3 boundary-action contract consumed by independent P3 reconstruction.


def compare_published_actions(published: dict, reconstructed: dict[int, list[float]], label: str) -> float:  # Prove that independent P3 element-action assembly matches the persisted P2 interface or anchor contract.
    converted = {int(node): [float(value) for value in vector] for node, vector in published.items()}  # Convert JSON node keys and vector scalars without defaults.
    if set(converted) != set(reconstructed):  # Require exact node coverage on the compared physical boundary.
        raise RuntimeError(f"{label} node coverage differs between P2 publication and P3 reconstruction")  # Stop before silently dropping an interface or anchor action.
    maximum = 0.0  # Initialize the largest Cartesian action mismatch in newtons.
    for node in sorted(converted):  # Compare every published physical boundary node deterministically.
        difference = [converted[node][axis] - reconstructed[node][axis] for axis in range(3)]  # Form the independent three-component difference vector.
        maximum = max(maximum, vector_norm(difference))  # Preserve the worst nodal mismatch magnitude.
    if maximum > ACTION_ABS_TOL_N:  # Enforce a tight serialization-scale action identity before condensation.
        raise RuntimeError(f"{label} action mismatch exceeds {ACTION_ABS_TOL_N} N: {maximum}")  # Stop before transferring an unverified base load.
    return maximum  # Return the accepted maximum action mismatch for the P3 receipt.


def assemble_plane_condensation(sign: int, plane_nodes: set[int], plane_elements: list[int], interface_nodes: set[int], internal_nodes: set[int], anchor_nodes: set[int], coordinated_nodes: dict[int, tuple[float, float, float]], element_states: dict[int, dict], state: dict) -> dict:  # Assemble and statically condense one independent signed suspension plane.
    interface_dofs = [(node, dof) for node in sorted(interface_nodes) for dof in range(3)]  # Freeze the retained shared-node translation ordering used by Schur condensation and deck equations.
    internal_dofs = [(node, dof) for node in sorted(internal_nodes) for dof in range(3)]  # Freeze the eliminated suspension-only translation ordering used by displacement recovery.
    free_dofs = interface_dofs + internal_dofs  # Assemble only non-anchor suspension degrees while retaining anchor stiffness contributions on free diagonals.
    free_index = {degree: index for index, degree in enumerate(free_dofs)}  # Map each physical node-direction pair to one dense tangent index.
    stiffness = zero_matrix(len(free_dofs), len(free_dofs))  # Allocate the complete free suspension-plane tangent before partitioning.
    base_actions: dict[int, list[float]] = {}  # Reconstruct P2 element actions plus half-element self-weight at every plane node.
    self_weight_actions: dict[int, list[float]] = {}  # Preserve the interface self-weight contribution independently for the load-transfer receipt.
    element_tangents: dict[int, list[list[float]]] = {}  # Preserve each 3-by-3 tangent block for response and anchor-reaction recovery.
    for element_id in sorted(plane_elements):  # Visit every cable and hanger element in this signed plane exactly once.
        record = element_states[element_id]  # Recover its complete v3 constitutive state.
        node_a, node_b = (int(value) for value in record["nodeIds"])  # Recover ordered physical endpoints.
        if node_a not in plane_nodes or node_b not in plane_nodes:  # Require a plane-local noncrossing suspension topology.
            raise RuntimeError(f"suspension element {element_id} crosses condensed plane boundaries")  # Stop before introducing false transverse coupling.
        tangent, unit = suspension_element_tangent(element_id, element_states, coordinated_nodes)  # Build its material-plus-geometric global tangent.
        element_tangents[element_id] = tangent  # Preserve the exact block for post-solve physical recovery.
        for row_node, row_sign in ((node_a, 1.0), (node_b, -1.0)):  # Assemble both standard truss tangent row blocks.
            for column_node, column_sign in ((node_a, 1.0), (node_b, -1.0)):  # Assemble both standard truss tangent column blocks.
                for row_dof in range(3):  # Resolve every global row direction.
                    row_index = free_index.get((row_node, row_dof))  # Skip only fixed physical anchor rows.
                    if row_index is None:  # Leave fixed-anchor degrees outside the solved free system.
                        continue  # Preserve their effects through free diagonal and later reaction recovery.
                    for column_dof in range(3):  # Resolve every global column direction.
                        column_index = free_index.get((column_node, column_dof))  # Skip only fixed physical anchor columns.
                        if column_index is not None:  # Add contributions only between active free degrees.
                            stiffness[row_index][column_index] += row_sign * column_sign * tangent[row_dof][column_dof]  # Assemble the symmetric positive standard tangent block.
        axial_force = float(record["axialForceN"])  # Recover the positive equilibrium tensile force.
        element_action_a = tuple(axial_force * component for component in unit)  # Compute the element force exerted on endpoint A in the P2 equilibrium state.
        add_vector(base_actions, node_a, element_action_a)  # Add the tensile action pulling endpoint A toward endpoint B.
        add_vector(base_actions, node_b, tuple(-value for value in element_action_a))  # Add the equal-and-opposite tensile action at endpoint B.
        area = MAIN_CABLE_AREA_MM2 if record["group"] == "MAIN_CABLES" else HANGER_AREA_MM2  # Select the frozen physical area for suspension self-weight.
        weight = area * STEEL_DENSITY_T_MM3 * GRAVITY_MM_S2 * float(record["equilibriumLengthMm"])  # Reconstruct the complete element dead weight in newtons.
        half_weight = (0.0, 0.0, -0.5 * weight)  # Form the same two-node lumped body-load vector used by the v3 equilibrium solver.
        add_vector(base_actions, node_a, half_weight)  # Include endpoint A self-weight in the base interface, internal, or anchor action.
        add_vector(base_actions, node_b, half_weight)  # Include endpoint B self-weight in the base interface, internal, or anchor action.
        add_vector(self_weight_actions, node_a, half_weight)  # Preserve endpoint A self-weight independently for interface-load provenance.
        add_vector(self_weight_actions, node_b, half_weight)  # Preserve endpoint B self-weight independently for interface-load provenance.
    interface_actions = {node: base_actions[node] for node in sorted(interface_nodes)}  # Extract total cable traction plus suspension self-weight applied at every retained interface node.
    anchor_actions = {node: base_actions[node] for node in sorted(anchor_nodes)}  # Extract total element action plus suspension self-weight applied at every physical cable anchor.
    internal_residual = max((vector_norm(base_actions.get(node, [0.0, 0.0, 0.0])) for node in internal_nodes), default=float("inf"))  # Verify free eliminated-node equilibrium before static condensation.
    if internal_residual > FORM_RESIDUAL_TOL_N:  # Require the v3 equilibrium state to close on every eliminated physical node.
        raise RuntimeError(f"signed plane {sign} internal P2 residual exceeds {FORM_RESIDUAL_TOL_N} N: {internal_residual}")  # Stop before condensing a nonequilibrated subsystem.
    published_plane = published_plane_for_sign(state, sign)  # Recover the authoritative complete-plane v3 action publication.
    interface_action_error = compare_published_actions(published_plane["interfaceActionsN"], interface_actions, f"signed plane {sign} interface")  # Prove interface load identity including self-weight.
    anchor_action_error = compare_published_actions(published_plane["anchorActionsN"], anchor_actions, f"signed plane {sign} anchor")  # Prove anchor action identity for later reaction recovery.
    interface_count = len(interface_dofs)  # Freeze the Schur interface matrix order.
    internal_count = len(internal_dofs)  # Freeze the eliminated internal matrix order.
    matrix_ii = [row[:interface_count] for row in stiffness[:interface_count]]  # Extract the direct interface tangent block.
    matrix_ij = [row[interface_count:] for row in stiffness[:interface_count]]  # Extract interface-to-internal coupling.
    matrix_jj = [row[interface_count:] for row in stiffness[interface_count:]]  # Extract the internal free-node tangent block.
    factor_jj, internal_factor_receipt = cholesky(matrix_jj, f"signed plane {sign} K_JJ")  # Prove internal stability and factor without regularization.
    solved = zero_matrix(internal_count, interface_count)  # Allocate K_JJ inverse times K_JI for Schur construction and recovery.
    for interface_column in range(interface_count):  # Solve one exact internal response to each unit interface direction.
        right_hand_side = [matrix_ij[interface_column][internal_row] for internal_row in range(internal_count)]  # Form the corresponding K_JI column by symmetry.
        column_solution = solve_cholesky(factor_jj, right_hand_side)  # Solve the accepted SPD internal subsystem.
        for internal_row in range(internal_count):  # Store the solved column in row-major recovery order.
            solved[internal_row][interface_column] = column_solution[internal_row]  # Preserve K_JJ inverse K_JI without sign reversal.
    condensed = zero_matrix(interface_count, interface_count)  # Allocate the exact interface Schur complement Kc.
    for row in range(interface_count):  # Assemble every condensed interface row.
        for column in range(interface_count):  # Assemble every condensed interface column.
            reduction = 0.0  # Initialize the K_IJ K_JJ-inverse K_JI contribution.
            for internal_index in range(internal_count):  # Contract across all eliminated internal degrees.
                reduction += matrix_ij[row][internal_index] * solved[internal_index][column]  # Accumulate one exact static-condensation term.
            condensed[row][column] = matrix_ii[row][column] - reduction  # Form the physical Schur complement with no diagonal penalty.
    symmetry_numerator = math.sqrt(sum((condensed[row][column] - condensed[column][row]) ** 2 for row in range(interface_count) for column in range(interface_count)))  # Measure floating-point Schur asymmetry.
    symmetry_denominator = max(math.sqrt(sum(value * value for row in condensed for value in row)), 1.0)  # Normalize by the physical condensed stiffness magnitude.
    symmetry_relative = symmetry_numerator / symmetry_denominator  # Form a dimensionless symmetry error receipt.
    if symmetry_relative > MATRIX_REL_TOL:  # Reject a numerically inconsistent Schur complement.
        raise RuntimeError(f"signed plane {sign} condensed tangent symmetry error is {symmetry_relative}")  # Stop before serializing a nonsymmetric spring surrogate.
    for row in range(interface_count):  # Remove only antisymmetric roundoff before positive factorization.
        for column in range(row):  # Visit each strict lower-upper pair once.
            average = 0.5 * (condensed[row][column] + condensed[column][row])  # Compute the energy-consistent symmetric value.
            condensed[row][column] = average  # Store the accepted lower entry.
            condensed[column][row] = average  # Store the identical upper entry.
    factor_condensed, condensed_factor_receipt = cholesky(condensed, f"signed plane {sign} K_condensed")  # Prove the anchored interface stiffness is positive definite without stabilization.
    reconstruction_numerator = 0.0  # Initialize the squared Cholesky reconstruction error.
    reconstruction_denominator = 0.0  # Initialize the squared physical condensed stiffness magnitude.
    for row in range(interface_count):  # Reconstruct each condensed tangent row from L times L-transpose.
        for column in range(interface_count):  # Reconstruct each condensed tangent entry.
            reconstructed = sum(factor_condensed[row][index] * factor_condensed[column][index] for index in range(min(row, column) + 1))  # Evaluate the exact lower-factor contraction.
            reconstruction_numerator += (reconstructed - condensed[row][column]) ** 2  # Accumulate the squared serialization-source error.
            reconstruction_denominator += condensed[row][column] ** 2  # Accumulate the squared physical reference magnitude.
    reconstruction_relative = math.sqrt(reconstruction_numerator / max(reconstruction_denominator, 1.0))  # Form the dimensionless factor reconstruction error.
    if reconstruction_relative > MATRIX_REL_TOL:  # Reject an inaccurate rank-one spring representation source.
        raise RuntimeError(f"signed plane {sign} Cholesky reconstruction error is {reconstruction_relative}")  # Stop before emitting a stiffness-changing deck.
    recovery = [[-solved[row][column] for column in range(interface_count)] for row in range(internal_count)]  # Form u_J equals minus K_JJ-inverse K_JI u_I for homogeneous incremental suspension equilibrium.
    modes: list[dict] = []  # Build one exact normalized rank-one spring mode per Cholesky column.
    for mode_index in range(interface_count):  # Visit every positive condensed Cholesky column once.
        column = [factor_condensed[row][mode_index] for row in range(interface_count)]  # Recover one lower-factor column whose outer product contributes to Kc.
        scale = max(abs(value) for value in column)  # Normalize the MPC coefficients so the dependent coefficient remains at least as large as every independent coefficient.
        if scale <= 0.0 or not math.isfinite(scale):  # Reject an impossible zero or nonfinite positive-definite factor column.
            raise RuntimeError(f"signed plane {sign} has an invalid condensed spring mode {mode_index}")  # Stop before a zero-stiffness auxiliary degree is created.
        modes.append({"vector": [value / scale for value in column], "stiffnessNPerMm": scale * scale})  # Preserve an energy-exact dimensionless equation vector and positive spring stiffness.
    receipt = {"sign": sign, "interfaceNodeCount": len(interface_nodes), "interfaceDofCount": interface_count, "internalNodeCount": len(internal_nodes), "internalDofCount": internal_count, "anchorNodeCount": len(anchor_nodes), "internalBaseResidualN": internal_residual, "interfaceActionReconstructionErrorN": interface_action_error, "anchorActionReconstructionErrorN": anchor_action_error, "interfaceSelfWeightResultantN": [sum(self_weight_actions[node][axis] for node in interface_nodes) for axis in range(3)], "internalFactor": internal_factor_receipt, "condensedFactor": condensed_factor_receipt, "schurSymmetryRelative": symmetry_relative, "factorReconstructionRelative": reconstruction_relative, "regularizationAddedNPerMm": 0.0}  # Publish complete numerical and physical condensation evidence.
    return {"sign": sign, "nodes": set(plane_nodes), "elements": list(plane_elements), "interfaceNodes": set(interface_nodes), "internalNodes": set(internal_nodes), "anchorNodes": set(anchor_nodes), "interfaceDofs": interface_dofs, "internalDofs": internal_dofs, "condensed": condensed, "recovery": recovery, "modes": modes, "baseActions": base_actions, "selfWeightActions": self_weight_actions, "elementTangents": element_tangents, "receipt": receipt}  # Return the in-memory physical operators and compact auditable receipt.


def build_suspension_condensation(text: str, nodes: dict[int, tuple[float, float, float]], groups: dict[str, list[tuple[int, list[int]]]], coordinated_nodes: dict[int, tuple[float, float, float]], element_states: dict[int, dict], state: dict) -> dict:  # Build both independent signed Schur complements from the verified v3 suspension state.
    nsets = parse_nsets(text)  # Recover physical anchor nodes from the immutable source support contract.
    retained_nodes = {node for group_name in PRIMARY_RETAINED_GROUPS for _element_id, connectivity in groups.get(group_name, []) for node in connectivity}  # Freeze every node participating in the primary retained deck or tower topology.
    suspension_nodes = {node for group_name in SUSPENSION_GROUPS for _element_id, connectivity in groups[group_name] for node in connectivity[:2]}  # Freeze the complete two-plane suspension node population.
    anchor_nodes = set(nsets.get("MAIN_CABLE_ANCHORS", set())) & suspension_nodes  # Restrict physical anchor supports to actual condensed suspension nodes.
    interface_nodes = (retained_nodes & suspension_nodes) - anchor_nodes  # Define shared deck-hanger and tower-saddle nodes as the exact retained interface.
    internal_nodes = suspension_nodes - interface_nodes - anchor_nodes  # Define every remaining cable-only node as an eliminated internal degree set.
    if not anchor_nodes or not interface_nodes or not internal_nodes:  # Require all three physical substructure partitions to be nonempty.
        raise RuntimeError("suspension partition requires physical anchors, retained interfaces, and internal nodes")  # Stop before an undefined or grounded-at-the-wrong-place condensation.
    element_index = {element_id: connectivity[:2] for group_name in SUSPENSION_GROUPS for element_id, connectivity in groups[group_name]}  # Index complete suspension topology by source element label.
    planes: list[dict] = []  # Accumulate one independent condensed operator for each signed cable plane.
    for sign in (1, -1):  # Preserve deterministic positive-then-negative transverse plane order.
        plane_nodes = {node for node in suspension_nodes if (coordinated_nodes[node][1] > 0.0) == (sign > 0)}  # Select every suspension node by its nonzero signed transverse coordinate.
        if any(abs(coordinated_nodes[node][1]) <= 1.0e-12 for node in suspension_nodes):  # Reject a node that cannot be assigned uniquely to one physical plane.
            raise RuntimeError("suspension node lies on the plane-selection boundary y=0")  # Stop before arbitrarily duplicating or omitting a node.
        plane_elements = [element_id for element_id, connectivity in element_index.items() if connectivity[0] in plane_nodes and connectivity[1] in plane_nodes]  # Select all and only within-plane cable and hanger elements.
        plane = assemble_plane_condensation(sign, plane_nodes, plane_elements, interface_nodes & plane_nodes, internal_nodes & plane_nodes, anchor_nodes & plane_nodes, coordinated_nodes, element_states, state)  # Build the exact physical tangent and recovery operators for this plane.
        planes.append(plane)  # Preserve the accepted signed-plane condensation.
    if set().union(*(plane["nodes"] for plane in planes)) != suspension_nodes or sum(len(plane["elements"]) for plane in planes) != len(element_index):  # Require exact nonoverlapping coverage of the complete suspension topology.
        raise RuntimeError("signed-plane condensation did not cover the complete suspension subsystem exactly once")  # Stop before partial stiffness or response recovery.
    interface_loads: dict[tuple[int, int], float] = {}  # Assemble the total P2 interface load including suspension self-weight from both planes.
    for plane in planes:  # Visit both accepted signed-plane base states.
        for node in plane["interfaceNodes"]:  # Visit every physical deck or tower interface node once.
            for dof in range(3):  # Transfer all Cartesian base-action components.
                interface_loads[(node, dof + 1)] = plane["baseActions"][node][dof]  # Apply cable traction plus half-element suspension self-weight, not traction alone.
    receipt = {"representation": "two independent anchored axial suspension tangents statically condensed to retained shared nodes", "interfaceNodeCount": len(interface_nodes), "internalNodeCount": len(internal_nodes), "anchorNodeCount": len(anchor_nodes), "suspensionNodeCount": len(suspension_nodes), "suspensionElementCount": len(element_index), "windPrimaryIncluded": False, "interfaceLoadIncludesSuspensionSelfWeight": True, "planes": [plane["receipt"] for plane in planes]}  # Publish the canonical physical condensation contract without dense matrices.
    return {"planes": planes, "retainedNodes": retained_nodes, "suspensionNodes": suspension_nodes, "interfaceNodes": interface_nodes, "internalNodes": internal_nodes, "anchorNodes": anchor_nodes, "interfaceLoads": interface_loads, "receipt": receipt}  # Return complete in-memory operators and their compact audit receipt.
