! D10 POST1 recovery: read existing RSTP, do not re-solve.
! Skip 80 x full-model PRNSOL (that is why the original POST1 never finished).
! PFACT/EFFM may read as 0 after RESUME of the static eq.db; SENE+probes are the pairing evidence.
FINISH
/FILNAME,cw_D10x_0827t075458,1
/NERR,100000,100000
/POST1
FILE,cw_D10x_0827t075458,rstp
SET,LAST
*GET,D10_AVAILABLE,ACTIVE,0,SET,NSET
D10_REQUESTED=80
*IF,D10_AVAILABLE,LT,20,THEN
/OUTPUT,d10_gate_status,txt
/COM,STATUS=REJECTED REASON=MODAL_RESULT_COUNT_MISMATCH
/OUTPUT
/EXIT,NOSAVE
*ENDIF
D10_EXPORTED=D10_AVAILABLE
/OUTPUT,d10_modal_export_manifest,txt
*VWRITE,D10_REQUESTED,D10_AVAILABLE,D10_EXPORTED
('REQUESTED=',F12.0,', AVAILABLE=',F12.0,', EXPORTED=',F12.0)
/OUTPUT
/OUTPUT,d10_modal_set_list,txt
SET,LIST
/OUTPUT
/NOPR
*CFOPEN,d10_modal_properties,csv
*DO,D10_I,1,D10_EXPORTED
SET,1,D10_I
*GET,D10_F,ACTIVE,0,SET,FREQ
D10_G=0
D10_PX=0
D10_PY=0
D10_PZ=0
D10_PRX=0
D10_PRY=0
D10_PRZ=0
D10_EX=0
D10_EY=0
D10_EZ=0
D10_ERX=0
D10_ERY=0
D10_ERZ=0
*GET,D10_G,MODE,D10_I,GENM
*GET,D10_PX,MODE,D10_I,PFACT,,DIREC,X
*GET,D10_PY,MODE,D10_I,PFACT,,DIREC,Y
*GET,D10_PZ,MODE,D10_I,PFACT,,DIREC,Z
*GET,D10_PRX,MODE,D10_I,PFACT,,DIREC,ROTX
*GET,D10_PRY,MODE,D10_I,PFACT,,DIREC,ROTY
*GET,D10_PRZ,MODE,D10_I,PFACT,,DIREC,ROTZ
*GET,D10_EX,MODE,D10_I,EFFM,,DIREC,X
*GET,D10_EY,MODE,D10_I,EFFM,,DIREC,Y
*GET,D10_EZ,MODE,D10_I,EFFM,,DIREC,Z
*GET,D10_ERX,MODE,D10_I,EFFM,,DIREC,ROTX
*GET,D10_ERY,MODE,D10_I,EFFM,,DIREC,ROTY
*GET,D10_ERZ,MODE,D10_I,EFFM,,DIREC,ROTZ
*VWRITE,D10_I,D10_F,D10_G,D10_PX,D10_PY,D10_PZ,D10_PRX,D10_PRY,D10_PRZ,D10_EX,D10_EY,D10_EZ,D10_ERX,D10_ERY,D10_ERZ
(F8.0,14(',',E24.16))
*ENDDO
*CFCLOS
/GOPR
FINISH
RESUME,cw_D10x_0827t075458_eq,db
/POST1
FILE,cw_D10x_0827t075458,rstp
SET,LAST
*GET,D10_EXPORTED,ACTIVE,0,SET,NSET
*IF,D10_EXPORTED,LT,20,THEN
/OUTPUT,d10_gate_status,txt
/COM,STATUS=REJECTED REASON=MODAL_RESULT_COUNT_MISMATCH
/OUTPUT
/EXIT,NOSAVE
*ENDIF
! Last RSTP set may be interrupted during MXPAND element output (C20: Mode 51).
D10_ENERGY=D10_EXPORTED
*IF,D10_EXPORTED,GE,51,THEN
D10_ENERGY=50
*ENDIF
/NERR,100000,100000

! Station probes on TYPE4 (cables): two catwalks at five X stations.
! X mm: north side, Q1, mid, Q3, south side.
D10_XS1=372853
D10_XS2=1272409
D10_XS3=1847909
D10_XS4=2423409
D10_XS5=3361547
*DIM,D10_PN,,10
*DO,D10_K,1,5
*IF,D10_K,EQ,1,THEN
D10_XS=D10_XS1
*ENDIF
*IF,D10_K,EQ,2,THEN
D10_XS=D10_XS2
*ENDIF
*IF,D10_K,EQ,3,THEN
D10_XS=D10_XS3
*ENDIF
*IF,D10_K,EQ,4,THEN
D10_XS=D10_XS4
*ENDIF
*IF,D10_K,EQ,5,THEN
D10_XS=D10_XS5
*ENDIF
ALLSEL,ALL
ESEL,S,TYPE,,4
NSLE,S
NSEL,R,LOC,X,D10_XS-1500,D10_XS+1500
NSEL,R,LOC,Y,18000,25000
*GET,D10_NC,NODE,0,COUNT
D10_NID=0
*IF,D10_NC,GT,0,THEN
*GET,D10_NID,NODE,0,NUM,MIN
*ENDIF
D10_PN(D10_K)=D10_NID
ALLSEL,ALL
ESEL,S,TYPE,,4
NSLE,S
NSEL,R,LOC,X,D10_XS-1500,D10_XS+1500
NSEL,R,LOC,Y,-25000,-18000
*GET,D10_NC,NODE,0,COUNT
D10_NID=0
*IF,D10_NC,GT,0,THEN
*GET,D10_NID,NODE,0,NUM,MIN
*ENDIF
D10_PN(D10_K+5)=D10_NID
*ENDDO
ALLSEL,ALL
CMSEL,S,GATE_TOPPOST_E
NSLE,S
*GET,D10_NC,NODE,0,COUNT
D10_GP=0
*IF,D10_NC,GT,0,THEN
*GET,D10_GP,NODE,0,NUM,MIN
*ENDIF
ALLSEL,ALL
/OUTPUT,d10_probe_nodes,txt
*VWRITE,D10_PN(1),D10_PN(2),D10_PN(3),D10_PN(4),D10_PN(5),D10_PN(6),D10_PN(7),D10_PN(8),D10_PN(9),D10_PN(10),D10_GP
('P+',5F12.0,/,'P-',5F12.0,/,'GATE_TOPPOST_NODE=',F12.0)
/OUTPUT

*DO,D10_I,1,D10_ENERGY
SET,1,D10_I
ALLSEL,ALL
ETABLE,ERAS
ETABLE,S10SENE,SENE
SSUM
*GET,D10_T,SSUM,0,ITEM,S10SENE
*IF,D10_T,LE,0,THEN
D10_T=1.0E-30
*ENDIF
CMSEL,S,GATE_BOTTOM_E
SSUM
*GET,D10_E61,SSUM,0,ITEM,S10SENE
CMSEL,S,GATE_TOPPOST_E
SSUM
*GET,D10_E62,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_CHORD152_E
SSUM
*GET,D10_E63,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_FRAME102_E
SSUM
*GET,D10_E64,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_BRACE51_E
SSUM
*GET,D10_E65,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_RHS5030_E
SSUM
*GET,D10_E66,SSUM,0,ITEM,S10SENE
D10_R61=D10_E61/D10_T
D10_R62=D10_E62/D10_T
D10_R63=D10_E63/D10_T
D10_R64=D10_E64/D10_T
D10_R65=D10_E65/D10_T
D10_R66=D10_E66/D10_T
D10_ES=D10_E61+D10_E62+D10_E63+D10_E64+D10_E65+D10_E66
D10_RS=D10_ES/D10_T
*CFOPEN,d10_section_modal_sene,csv,,APPEND
*VWRITE,D10_I,D10_T,D10_E61,D10_E62,D10_E63,D10_E64,D10_E65,D10_E66,D10_R61,D10_R62,D10_R63,D10_R64,D10_R65,D10_R66,D10_ES,D10_RS
(F8.0,15(',',E24.16))
*CFCLOS
ALLSEL,ALL
ESEL,S,TYPE,,4
SSUM
*GET,D10_T4E,SSUM,0,ITEM,S10SENE
ESEL,S,TYPE,,6
SSUM
*GET,D10_T6E,SSUM,0,ITEM,S10SENE
ESEL,S,TYPE,,70
SSUM
*GET,D10_T70E,SSUM,0,ITEM,S10SENE
D10_RT4=D10_T4E/D10_T
D10_RT6=D10_T6E/D10_T
D10_RT70=D10_T70E/D10_T
*CFOPEN,d10_modal_sene_groups,csv,,APPEND
*VWRITE,D10_I,D10_T,D10_T4E,D10_T6E,D10_T70E,D10_E61,D10_E62,D10_ES,D10_RT4,D10_RT6,D10_RT70,D10_R61,D10_R62,D10_RS
(F8.0,13(',',E24.16))
*CFCLOS
ALLSEL,ALL
*ENDDO

*CFOPEN,d10_mode_probes,csv
*DO,D10_I,1,D10_ENERGY
SET,1,D10_I
*GET,D10_F,ACTIVE,0,SET,FREQ
*DO,D10_K,1,10
D10_NID=D10_PN(D10_K)
D10_UX=0
D10_UY=0
D10_UZ=0
D10_RX=0
D10_RY=0
D10_RZ=0
*IF,D10_NID,GT,0,THEN
*GET,D10_UX,NODE,D10_NID,U,X
*GET,D10_UY,NODE,D10_NID,U,Y
*GET,D10_UZ,NODE,D10_NID,U,Z
*GET,D10_RX,NODE,D10_NID,ROT,X
*GET,D10_RY,NODE,D10_NID,ROT,Y
*GET,D10_RZ,NODE,D10_NID,ROT,Z
*ENDIF
*VWRITE,D10_I,D10_F,D10_K,D10_NID,D10_UX,D10_UY,D10_UZ,D10_RX,D10_RY,D10_RZ
(F8.0,',',E24.16,',',F8.0,',',F12.0,6(',',E24.16))
*ENDDO
D10_GUX=0
D10_GUY=0
D10_GUZ=0
D10_GRX=0
D10_GRY=0
D10_GRZ=0
*IF,D10_GP,GT,0,THEN
*GET,D10_GUX,NODE,D10_GP,U,X
*GET,D10_GUY,NODE,D10_GP,U,Y
*GET,D10_GUZ,NODE,D10_GP,U,Z
*GET,D10_GRX,NODE,D10_GP,ROT,X
*GET,D10_GRY,NODE,D10_GP,ROT,Y
*GET,D10_GRZ,NODE,D10_GP,ROT,Z
*ENDIF
*VWRITE,D10_I,D10_F,11,D10_GP,D10_GUX,D10_GUY,D10_GUZ,D10_GRX,D10_GRY,D10_GRZ
(F8.0,',',E24.16,',',F8.0,',',F12.0,6(',',E24.16))
*ENDDO
*CFCLOS
/GOPR

! Static RST: force and moment resultants at UZ supports (N15 global equilibrium).
FILE,cw_D10x_0827t075458,rst
SET,LAST
ALLSEL,ALL
NSEL,S,D,UZ
FSUM
*GET,D10_FX,FSUM,0,ITEM,FX
*GET,D10_FY,FSUM,0,ITEM,FY
*GET,D10_FZ,FSUM,0,ITEM,FZ
*GET,D10_MX,FSUM,0,ITEM,MX
*GET,D10_MY,FSUM,0,ITEM,MY
*GET,D10_MZ,FSUM,0,ITEM,MZ
ALLSEL,ALL
/OUTPUT,d10_static_fsum_uz_supports,txt
*VWRITE,D10_FX,D10_FY,D10_FZ
('FX=',E24.16,', FY=',E24.16,', FZ=',E24.16)
*VWRITE,D10_MX,D10_MY,D10_MZ
('MX=',E24.16,', MY=',E24.16,', MZ=',E24.16)
/OUTPUT
ALLSEL,ALL
SAVE,cw_D10x_0827t075458_modal,db
/OUTPUT,d10_gate_status,txt
/COM,STATUS=SOLVER_EXPORT_COMPLETED PHASE=POST1_CONTINUE
/OUTPUT
FINISH
/EXIT,NOSAVE
