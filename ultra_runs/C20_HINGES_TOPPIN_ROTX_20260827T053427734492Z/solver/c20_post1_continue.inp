*GET,C20_E64,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_BRACE51_E
SSUM
*GET,C20_E65,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_RHS5030_E
SSUM
*GET,C20_E66,SSUM,0,ITEM,S10SENE
C20_R61=C20_E61/C20_T
C20_R62=C20_E62/C20_T
C20_R63=C20_E63/C20_T
C20_R64=C20_E64/C20_T
C20_R65=C20_E65/C20_T
C20_R66=C20_E66/C20_T
C20_ES=C20_E61+C20_E62+C20_E63+C20_E64+C20_E65+C20_E66
C20_RS=C20_ES/C20_T
*CFOPEN,c20_section_modal_sene,csv,,APPEND
*VWRITE,C20_I,C20_T,C20_E61,C20_E62,C20_E63,C20_E64,C20_E65,C20_E66,C20_R61,C20_R62,C20_R63,C20_R64,C20_R65,C20_R66,C20_ES,C20_RS
(F8.0,15(',',E24.16))
*CFCLOS
ALLSEL,ALL
ESEL,S,TYPE,,4
SSUM
*GET,C20_T4E,SSUM,0,ITEM,S10SENE
ESEL,S,TYPE,,6
SSUM
*GET,C20_T6E,SSUM,0,ITEM,S10SENE
ESEL,S,TYPE,,70
SSUM
*GET,C20_T70E,SSUM,0,ITEM,S10SENE
C20_RT4=C20_T4E/C20_T
C20_RT6=C20_T6E/C20_T
C20_RT70=C20_T70E/C20_T
*CFOPEN,c20_modal_sene_groups,csv,,APPEND
*VWRITE,C20_I,C20_T,C20_T4E,C20_T6E,C20_T70E,C20_E61,C20_E62,C20_ES,C20_RT4,C20_RT6,C20_RT70,C20_R61,C20_R62,C20_RS
(F8.0,13(',',E24.16))
*CFCLOS
ALLSEL,ALL
*ENDDO

*CFOPEN,c20_mode_probes,csv
*DO,C20_I,1,C20_ENERGY
SET,1,C20_I
*GET,C20_F,ACTIVE,0,SET,FREQ
*DO,C20_K,1,10
C20_NID=C20_PN(C20_K)
C20_UX=0
C20_UY=0
C20_UZ=0
C20_RX=0
C20_RY=0
C20_RZ=0
*IF,C20_NID,GT,0,THEN
