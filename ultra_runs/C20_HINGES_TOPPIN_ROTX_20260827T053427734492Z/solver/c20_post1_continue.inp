*VWRITE,C20_I,C20_F,C20_K,C20_NID,C20_UX,C20_UY,C20_UZ,C20_RX,C20_RY,C20_RZ
(F8.0,',',E24.16,',',F8.0,',',F12.0,6(',',E24.16))
*ENDDO
C20_GUX=0
C20_GUY=0
C20_GUZ=0
C20_GRX=0
C20_GRY=0
C20_GRZ=0
