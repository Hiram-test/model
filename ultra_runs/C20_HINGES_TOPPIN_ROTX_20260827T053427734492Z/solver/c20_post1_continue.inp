! C20 POST1 recovery: read existing RSTP, do not re-solve.
! Skip 80 x full-model PRNSOL (that is why the original POST1 never finished).
! PFACT/EFFM from RSTP/MODE before RESUME of the static eq.db.
FINISH
/FILNAME,cw_C20x_0827t053427,1
/NERR,100000,100000
/POST1
FILE,cw_C20x_0827t053427,rstp
SET,LAST
*GET,C20_AVAILABLE,ACTIVE,0,SET,NSET
C20_REQUESTED=80
*IF,C20_AVAILABLE,LT,20,THEN
/OUTPUT,c20_gate_status,txt
/COM,STATUS=REJECTED REASON=MODAL_RESULT_COUNT_MISMATCH
/OUTPUT
/EXIT,NOSAVE
*ENDIF
C20_EXPORTED=C20_AVAILABLE
/OUTPUT,c20_modal_export_manifest,txt
*VWRITE,C20_REQUESTED,C20_AVAILABLE,C20_EXPORTED
('REQUESTED=',F12.0,', AVAILABLE=',F12.0,', EXPORTED=',F12.0)
/OUTPUT
/OUTPUT,c20_modal_set_list,txt
SET,LIST
/OUTPUT
/NOPR
*CFOPEN,c20_modal_properties,csv
*DO,C20_I,1,C20_EXPORTED
SET,1,C20_I
*GET,C20_F,ACTIVE,0,SET,FREQ
C20_G=0
C20_PX=0
C20_PY=0
C20_PZ=0
C20_PRX=0
C20_PRY=0
C20_PRZ=0
C20_EX=0
C20_EY=0
C20_EZ=0
C20_ERX=0
C20_ERY=0
C20_ERZ=0
*VWRITE,C20_I,C20_F,C20_G,C20_PX,C20_PY,C20_PZ,C20_PRX,C20_PRY,C20_PRZ,C20_EX,C20_EY,C20_EZ,C20_ERX,C20_ERY,C20_ERZ
(F8.0,14(',',E24.16))
*ENDDO
*CFCLOS
/GOPR
FINISH
RESUME,cw_C20x_0827t053427_eq,db
/POST1
FILE,cw_C20x_0827t053427,rstp
SET,LAST
*GET,C20_EXPORTED,ACTIVE,0,SET,NSET
*IF,C20_EXPORTED,LT,20,THEN
/OUTPUT,c20_gate_status,txt
/COM,STATUS=REJECTED REASON=MODAL_RESULT_COUNT_MISMATCH
/OUTPUT
/EXIT,NOSAVE
*ENDIF
! Last RSTP set was interrupted during MXPAND element output (STAT Mode=51).
C20_ENERGY=C20_EXPORTED
*IF,C20_EXPORTED,GE,51,THEN
C20_ENERGY=50
*ENDIF
/NERR,100000,100000

! Station probes on TYPE4 (cables): two catwalks at five X stations.
! X mm: north side, Q1, mid, Q3, south side.
C20_XS1=372853
C20_XS2=1272409
C20_XS3=1847909
C20_XS4=2423409
C20_XS5=3361547
*DIM,C20_PN,,10
*DO,C20_K,1,5
*IF,C20_K,EQ,1,THEN
C20_XS=C20_XS1
*ENDIF
*IF,C20_K,EQ,2,THEN
C20_XS=C20_XS2
*ENDIF
*IF,C20_K,EQ,3,THEN
C20_XS=C20_XS3
*ENDIF
*IF,C20_K,EQ,4,THEN
C20_XS=C20_XS4
*ENDIF
*IF,C20_K,EQ,5,THEN
C20_XS=C20_XS5
*ENDIF
ALLSEL,ALL
ESEL,S,TYPE,,4
NSLE,S
NSEL,R,LOC,X,C20_XS-1500,C20_XS+1500
NSEL,R,LOC,Y,18000,25000
*GET,C20_NC,NODE,0,COUNT
C20_NID=0
*IF,C20_NC,GT,0,THEN
*GET,C20_NID,NODE,0,NUM,MIN
*ENDIF
C20_PN(C20_K)=C20_NID
ALLSEL,ALL
ESEL,S,TYPE,,4
NSLE,S
NSEL,R,LOC,X,C20_XS-1500,C20_XS+1500
NSEL,R,LOC,Y,-25000,-18000
*GET,C20_NC,NODE,0,COUNT
C20_NID=0
*IF,C20_NC,GT,0,THEN
*GET,C20_NID,NODE,0,NUM,MIN
*ENDIF
C20_PN(C20_K+5)=C20_NID
*ENDDO
ALLSEL,ALL
CMSEL,S,GATE_TOPPOST_E
NSLE,S
*GET,C20_NC,NODE,0,COUNT
C20_GP=0
*IF,C20_NC,GT,0,THEN
*GET,C20_GP,NODE,0,NUM,MIN
*ENDIF
ALLSEL,ALL
/OUTPUT,c20_probe_nodes,txt
*VWRITE,C20_PN(1),C20_PN(2),C20_PN(3),C20_PN(4),C20_PN(5),C20_PN(6),C20_PN(7),C20_PN(8),C20_PN(9),C20_PN(10),C20_GP
('P+',5F12.0,/,'P-',5F12.0,/,'GATE_TOPPOST_NODE=',F12.0)
/OUTPUT

*DO,C20_I,1,C20_ENERGY
SET,1,C20_I
ALLSEL,ALL
ETABLE,ERAS
ETABLE,S10SENE,SENE
SSUM
*GET,C20_T,SSUM,0,ITEM,S10SENE
*IF,C20_T,LE,0,THEN
C20_T=1.0E-30
*ENDIF
CMSEL,S,GATE_BOTTOM_E
SSUM
*GET,C20_E61,SSUM,0,ITEM,S10SENE
CMSEL,S,GATE_TOPPOST_E
SSUM
*GET,C20_E62,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_CHORD152_E
SSUM
*GET,C20_E63,SSUM,0,ITEM,S10SENE
