*VWRITE,C20_I,C20_F,11,C20_GP,C20_GUX,C20_GUY,C20_GUZ,C20_GRX,C20_GRY,C20_GRZ
(F8.0,',',E24.16,',',F8.0,',',F12.0,6(',',E24.16))
*ENDDO
*CFCLOS
/GOPR

