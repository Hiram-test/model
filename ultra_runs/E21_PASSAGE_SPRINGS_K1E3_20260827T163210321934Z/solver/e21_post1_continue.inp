! D10 POST1 recovery: read existing RSTP, do not re-solve.
! Skip 80 x full-model PRNSOL (that is why the original POST1 never finished).
! PFACT/EFFM may read as 0 after RESUME of the static eq.db; SENE+probes are the pairing evidence.
FINISH
/FILNAME,cw_E21_0827t163210,1
/NERR,100000,100000
/POST1
FILE,cw_E21_0827t163210,rstp
SET,LAST
*GET,E21_AVAILABLE,ACTIVE,0,SET,NSET
E21_REQUESTED=80
*IF,E21_AVAILABLE,LT,20,THEN
/OUTPUT,e21_gate_status,txt
/COM,STATUS=REJECTED REASON=MODAL_RESULT_COUNT_MISMATCH
/OUTPUT
/EXIT,NOSAVE
*ENDIF
E21_EXPORTED=E21_AVAILABLE
/OUTPUT,e21_modal_export_manifest,txt
*VWRITE,E21_REQUESTED,E21_AVAILABLE,E21_EXPORTED
('REQUESTED=',F12.0,', AVAILABLE=',F12.0,', EXPORTED=',F12.0)
/OUTPUT
/OUTPUT,e21_modal_set_list,txt
SET,LIST
/OUTPUT
/NOPR
*CFOPEN,e21_modal_properties,csv
*DO,E21_I,1,E21_EXPORTED
SET,1,E21_I
*GET,E21_F,ACTIVE,0,SET,FREQ
E21_G=0
E21_PX=0
E21_PY=0
E21_PZ=0
E21_PRX=0
E21_PRY=0
E21_PRZ=0
E21_EX=0
E21_EY=0
E21_EZ=0
E21_ERX=0
E21_ERY=0
E21_ERZ=0
*GET,E21_G,MODE,E21_I,GENM
*GET,E21_PX,MODE,E21_I,PFACT,,DIREC,X
*GET,E21_PY,MODE,E21_I,PFACT,,DIREC,Y
*GET,E21_PZ,MODE,E21_I,PFACT,,DIREC,Z
*GET,E21_PRX,MODE,E21_I,PFACT,,DIREC,ROTX
*GET,E21_PRY,MODE,E21_I,PFACT,,DIREC,ROTY
*GET,E21_PRZ,MODE,E21_I,PFACT,,DIREC,ROTZ
*GET,E21_EX,MODE,E21_I,EFFM,,DIREC,X
*GET,E21_EY,MODE,E21_I,EFFM,,DIREC,Y
*GET,E21_EZ,MODE,E21_I,EFFM,,DIREC,Z
*GET,E21_ERX,MODE,E21_I,EFFM,,DIREC,ROTX
*GET,E21_ERY,MODE,E21_I,EFFM,,DIREC,ROTY
*GET,E21_ERZ,MODE,E21_I,EFFM,,DIREC,ROTZ
*VWRITE,E21_I,E21_F,E21_G,E21_PX,E21_PY,E21_PZ,E21_PRX,E21_PRY,E21_PRZ,E21_EX,E21_EY,E21_EZ,E21_ERX,E21_ERY,E21_ERZ
(F8.0,14(',',E24.16))
*ENDDO
*CFCLOS
/GOPR
FINISH
RESUME,cw_E21_0827t163210_eq,db
/POST1
FILE,cw_E21_0827t163210,rstp
SET,LAST
*GET,E21_EXPORTED,ACTIVE,0,SET,NSET
*IF,E21_EXPORTED,LT,20,THEN
/OUTPUT,e21_gate_status,txt
/COM,STATUS=REJECTED REASON=MODAL_RESULT_COUNT_MISMATCH
/OUTPUT
/EXIT,NOSAVE
*ENDIF
! Last RSTP set may be interrupted during MXPAND element output (C20: Mode 51).
E21_ENERGY=E21_EXPORTED
*IF,E21_EXPORTED,GE,51,THEN
E21_ENERGY=50
*ENDIF
/NERR,100000,100000

! Station probes on TYPE4 (cables): two catwalks at five X stations.
! X mm: north side, Q1, mid, Q3, south side.
E21_XS1=372853
E21_XS2=1272409
E21_XS3=1847909
E21_XS4=2423409
E21_XS5=3361547
*DIM,E21_PN,,10
*DO,E21_K,1,5
*IF,E21_K,EQ,1,THEN
E21_XS=E21_XS1
*ENDIF
*IF,E21_K,EQ,2,THEN
E21_XS=E21_XS2
*ENDIF
*IF,E21_K,EQ,3,THEN
E21_XS=E21_XS3
*ENDIF
*IF,E21_K,EQ,4,THEN
E21_XS=E21_XS4
*ENDIF
*IF,E21_K,EQ,5,THEN
E21_XS=E21_XS5
*ENDIF
ALLSEL,ALL
ESEL,S,TYPE,,4
NSLE,S
NSEL,R,LOC,X,E21_XS-1500,E21_XS+1500
NSEL,R,LOC,Y,18000,25000
*GET,E21_NC,NODE,0,COUNT
E21_NID=0
*IF,E21_NC,GT,0,THEN
*GET,E21_NID,NODE,0,NUM,MIN
*ENDIF
E21_PN(E21_K)=E21_NID
ALLSEL,ALL
ESEL,S,TYPE,,4
NSLE,S
NSEL,R,LOC,X,E21_XS-1500,E21_XS+1500
NSEL,R,LOC,Y,-25000,-18000
*GET,E21_NC,NODE,0,COUNT
E21_NID=0
*IF,E21_NC,GT,0,THEN
*GET,E21_NID,NODE,0,NUM,MIN
*ENDIF
E21_PN(E21_K+5)=E21_NID
*ENDDO
ALLSEL,ALL
CMSEL,S,GATE_TOPPOST_E
NSLE,S
*GET,E21_NC,NODE,0,COUNT
E21_GP=0
*IF,E21_NC,GT,0,THEN
*GET,E21_GP,NODE,0,NUM,MIN
*ENDIF
ALLSEL,ALL
/OUTPUT,e21_probe_nodes,txt
*VWRITE,E21_PN(1),E21_PN(2),E21_PN(3),E21_PN(4),E21_PN(5),E21_PN(6),E21_PN(7),E21_PN(8),E21_PN(9),E21_PN(10),E21_GP
('P+',5F12.0,/,'P-',5F12.0,/,'GATE_TOPPOST_NODE=',F12.0)
/OUTPUT

*DO,E21_I,1,E21_ENERGY
SET,1,E21_I
ALLSEL,ALL
ETABLE,ERAS
ETABLE,S10SENE,SENE
SSUM
*GET,E21_T,SSUM,0,ITEM,S10SENE
*IF,E21_T,LE,0,THEN
E21_T=1.0E-30
*ENDIF
CMSEL,S,GATE_BOTTOM_E
SSUM
*GET,E21_E61,SSUM,0,ITEM,S10SENE
CMSEL,S,GATE_TOPPOST_E
SSUM
*GET,E21_E62,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_CHORD152_E
SSUM
*GET,E21_E63,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_FRAME102_E
SSUM
*GET,E21_E64,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_BRACE51_E
SSUM
*GET,E21_E65,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_RHS5030_E
SSUM
*GET,E21_E66,SSUM,0,ITEM,S10SENE
E21_R61=E21_E61/E21_T
E21_R62=E21_E62/E21_T
E21_R63=E21_E63/E21_T
E21_R64=E21_E64/E21_T
E21_R65=E21_E65/E21_T
E21_R66=E21_E66/E21_T
E21_ES=E21_E61+E21_E62+E21_E63+E21_E64+E21_E65+E21_E66
E21_RS=E21_ES/E21_T
*CFOPEN,e21_section_modal_sene,csv,,APPEND
*VWRITE,E21_I,E21_T,E21_E61,E21_E62,E21_E63,E21_E64,E21_E65,E21_E66,E21_R61,E21_R62,E21_R63,E21_R64,E21_R65,E21_R66,E21_ES,E21_RS
(F8.0,15(',',E24.16))
*CFCLOS
ALLSEL,ALL
ESEL,S,TYPE,,4
SSUM
*GET,E21_T4E,SSUM,0,ITEM,S10SENE
ESEL,S,TYPE,,6
SSUM
*GET,E21_T6E,SSUM,0,ITEM,S10SENE
ESEL,S,TYPE,,70
SSUM
*GET,E21_T70E,SSUM,0,ITEM,S10SENE
E21_RT4=E21_T4E/E21_T
E21_RT6=E21_T6E/E21_T
E21_RT70=E21_T70E/E21_T
*CFOPEN,e21_modal_sene_groups,csv,,APPEND
*VWRITE,E21_I,E21_T,E21_T4E,E21_T6E,E21_T70E,E21_E61,E21_E62,E21_ES,E21_RT4,E21_RT6,E21_RT70,E21_R61,E21_R62,E21_RS
(F8.0,13(',',E24.16))
*CFCLOS
ALLSEL,ALL
*ENDDO

*CFOPEN,e21_mode_probes,csv
*DO,E21_I,1,E21_ENERGY
SET,1,E21_I
*GET,E21_F,ACTIVE,0,SET,FREQ
*DO,E21_K,1,10
E21_NID=E21_PN(E21_K)
E21_UX=0
E21_UY=0
E21_UZ=0
E21_RX=0
E21_RY=0
E21_RZ=0
*IF,E21_NID,GT,0,THEN
*GET,E21_UX,NODE,E21_NID,U,X
*GET,E21_UY,NODE,E21_NID,U,Y
*GET,E21_UZ,NODE,E21_NID,U,Z
*GET,E21_RX,NODE,E21_NID,ROT,X
*GET,E21_RY,NODE,E21_NID,ROT,Y
*GET,E21_RZ,NODE,E21_NID,ROT,Z
*ENDIF
*VWRITE,E21_I,E21_F,E21_K,E21_NID,E21_UX,E21_UY,E21_UZ,E21_RX,E21_RY,E21_RZ
(F8.0,',',E24.16,',',F8.0,',',F12.0,6(',',E24.16))
*ENDDO
E21_GUX=0
E21_GUY=0
E21_GUZ=0
E21_GRX=0
E21_GRY=0
E21_GRZ=0
*IF,E21_GP,GT,0,THEN
*GET,E21_GUX,NODE,E21_GP,U,X
*GET,E21_GUY,NODE,E21_GP,U,Y
*GET,E21_GUZ,NODE,E21_GP,U,Z
*GET,E21_GRX,NODE,E21_GP,ROT,X
*GET,E21_GRY,NODE,E21_GP,ROT,Y
*GET,E21_GRZ,NODE,E21_GP,ROT,Z
*ENDIF
*VWRITE,E21_I,E21_F,11,E21_GP,E21_GUX,E21_GUY,E21_GUZ,E21_GRX,E21_GRY,E21_GRZ
(F8.0,',',E24.16,',',F8.0,',',F12.0,6(',',E24.16))
*ENDDO
*CFCLOS
/GOPR

! Static RST: force and moment resultants at UZ supports (N15 global equilibrium).
FILE,cw_E21_0827t163210,rst
SET,LAST
ALLSEL,ALL
NSEL,S,D,UZ
FSUM
*GET,E21_FX,FSUM,0,ITEM,FX
*GET,E21_FY,FSUM,0,ITEM,FY
*GET,E21_FZ,FSUM,0,ITEM,FZ
*GET,E21_MX,FSUM,0,ITEM,MX
*GET,E21_MY,FSUM,0,ITEM,MY
*GET,E21_MZ,FSUM,0,ITEM,MZ
ALLSEL,ALL
/OUTPUT,e21_static_fsum_uz_supports,txt
*VWRITE,E21_FX,E21_FY,E21_FZ
('FX=',E24.16,', FY=',E24.16,', FZ=',E24.16)
*VWRITE,E21_MX,E21_MY,E21_MZ
('MX=',E24.16,', MY=',E24.16,', MZ=',E24.16)
/OUTPUT
ALLSEL,ALL
SAVE,cw_E21_0827t163210_modal,db
/OUTPUT,e21_gate_status,txt
/COM,STATUS=SOLVER_EXPORT_COMPLETED PHASE=POST1_CONTINUE
/OUTPUT
FINISH
/EXIT,NOSAVE
