! D10 POST1 recovery: read existing RSTP, do not re-solve.
! Skip 80 x full-model PRNSOL (that is why the original POST1 never finished).
! PFACT/EFFM may read as 0 after RESUME of the static eq.db; SENE+probes are the pairing evidence.
FINISH
/FILNAME,cw_E10_0827t125824,1
/NERR,100000,100000
/POST1
FILE,cw_E10_0827t125824,rstp
SET,LAST
*GET,E10_AVAILABLE,ACTIVE,0,SET,NSET
E10_REQUESTED=80
*IF,E10_AVAILABLE,LT,20,THEN
/OUTPUT,e10_gate_status,txt
/COM,STATUS=REJECTED REASON=MODAL_RESULT_COUNT_MISMATCH
/OUTPUT
/EXIT,NOSAVE
*ENDIF
E10_EXPORTED=E10_AVAILABLE
/OUTPUT,e10_modal_export_manifest,txt
*VWRITE,E10_REQUESTED,E10_AVAILABLE,E10_EXPORTED
('REQUESTED=',F12.0,', AVAILABLE=',F12.0,', EXPORTED=',F12.0)
/OUTPUT
/OUTPUT,e10_modal_set_list,txt
SET,LIST
/OUTPUT
/NOPR
*CFOPEN,e10_modal_properties,csv
*DO,E10_I,1,E10_EXPORTED
SET,1,E10_I
*GET,E10_F,ACTIVE,0,SET,FREQ
E10_G=0
E10_PX=0
E10_PY=0
E10_PZ=0
E10_PRX=0
E10_PRY=0
E10_PRZ=0
E10_EX=0
E10_EY=0
E10_EZ=0
E10_ERX=0
E10_ERY=0
E10_ERZ=0
*GET,E10_G,MODE,E10_I,GENM
*GET,E10_PX,MODE,E10_I,PFACT,,DIREC,X
*GET,E10_PY,MODE,E10_I,PFACT,,DIREC,Y
*GET,E10_PZ,MODE,E10_I,PFACT,,DIREC,Z
*GET,E10_PRX,MODE,E10_I,PFACT,,DIREC,ROTX
*GET,E10_PRY,MODE,E10_I,PFACT,,DIREC,ROTY
*GET,E10_PRZ,MODE,E10_I,PFACT,,DIREC,ROTZ
*GET,E10_EX,MODE,E10_I,EFFM,,DIREC,X
*GET,E10_EY,MODE,E10_I,EFFM,,DIREC,Y
*GET,E10_EZ,MODE,E10_I,EFFM,,DIREC,Z
*GET,E10_ERX,MODE,E10_I,EFFM,,DIREC,ROTX
*GET,E10_ERY,MODE,E10_I,EFFM,,DIREC,ROTY
*GET,E10_ERZ,MODE,E10_I,EFFM,,DIREC,ROTZ
*VWRITE,E10_I,E10_F,E10_G,E10_PX,E10_PY,E10_PZ,E10_PRX,E10_PRY,E10_PRZ,E10_EX,E10_EY,E10_EZ,E10_ERX,E10_ERY,E10_ERZ
(F8.0,14(',',E24.16))
*ENDDO
*CFCLOS
/GOPR
FINISH
RESUME,cw_E10_0827t125824_eq,db
/POST1
FILE,cw_E10_0827t125824,rstp
SET,LAST
*GET,E10_EXPORTED,ACTIVE,0,SET,NSET
*IF,E10_EXPORTED,LT,20,THEN
/OUTPUT,e10_gate_status,txt
/COM,STATUS=REJECTED REASON=MODAL_RESULT_COUNT_MISMATCH
/OUTPUT
/EXIT,NOSAVE
*ENDIF
! Last RSTP set may be interrupted during MXPAND element output (C20: Mode 51).
E10_ENERGY=E10_EXPORTED
*IF,E10_EXPORTED,GE,51,THEN
E10_ENERGY=50
*ENDIF
/NERR,100000,100000

! Station probes on TYPE4 (cables): two catwalks at five X stations.
! X mm: north side, Q1, mid, Q3, south side.
E10_XS1=372853
E10_XS2=1272409
E10_XS3=1847909
E10_XS4=2423409
E10_XS5=3361547
*DIM,E10_PN,,10
*DO,E10_K,1,5
*IF,E10_K,EQ,1,THEN
E10_XS=E10_XS1
*ENDIF
*IF,E10_K,EQ,2,THEN
E10_XS=E10_XS2
*ENDIF
*IF,E10_K,EQ,3,THEN
E10_XS=E10_XS3
*ENDIF
*IF,E10_K,EQ,4,THEN
E10_XS=E10_XS4
*ENDIF
*IF,E10_K,EQ,5,THEN
E10_XS=E10_XS5
*ENDIF
ALLSEL,ALL
ESEL,S,TYPE,,4
NSLE,S
NSEL,R,LOC,X,E10_XS-1500,E10_XS+1500
NSEL,R,LOC,Y,18000,25000
*GET,E10_NC,NODE,0,COUNT
E10_NID=0
*IF,E10_NC,GT,0,THEN
*GET,E10_NID,NODE,0,NUM,MIN
*ENDIF
E10_PN(E10_K)=E10_NID
ALLSEL,ALL
ESEL,S,TYPE,,4
NSLE,S
NSEL,R,LOC,X,E10_XS-1500,E10_XS+1500
NSEL,R,LOC,Y,-25000,-18000
*GET,E10_NC,NODE,0,COUNT
E10_NID=0
*IF,E10_NC,GT,0,THEN
*GET,E10_NID,NODE,0,NUM,MIN
*ENDIF
E10_PN(E10_K+5)=E10_NID
*ENDDO
ALLSEL,ALL
CMSEL,S,GATE_TOPPOST_E
NSLE,S
*GET,E10_NC,NODE,0,COUNT
E10_GP=0
*IF,E10_NC,GT,0,THEN
*GET,E10_GP,NODE,0,NUM,MIN
*ENDIF
ALLSEL,ALL
/OUTPUT,e10_probe_nodes,txt
*VWRITE,E10_PN(1),E10_PN(2),E10_PN(3),E10_PN(4),E10_PN(5),E10_PN(6),E10_PN(7),E10_PN(8),E10_PN(9),E10_PN(10),E10_GP
('P+',5F12.0,/,'P-',5F12.0,/,'GATE_TOPPOST_NODE=',F12.0)
/OUTPUT

*DO,E10_I,1,E10_ENERGY
SET,1,E10_I
ALLSEL,ALL
ETABLE,ERAS
ETABLE,S10SENE,SENE
SSUM
*GET,E10_T,SSUM,0,ITEM,S10SENE
*IF,E10_T,LE,0,THEN
E10_T=1.0E-30
*ENDIF
CMSEL,S,GATE_BOTTOM_E
SSUM
*GET,E10_E61,SSUM,0,ITEM,S10SENE
CMSEL,S,GATE_TOPPOST_E
SSUM
*GET,E10_E62,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_CHORD152_E
SSUM
*GET,E10_E63,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_FRAME102_E
SSUM
*GET,E10_E64,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_BRACE51_E
SSUM
*GET,E10_E65,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_RHS5030_E
SSUM
*GET,E10_E66,SSUM,0,ITEM,S10SENE
E10_R61=E10_E61/E10_T
E10_R62=E10_E62/E10_T
E10_R63=E10_E63/E10_T
E10_R64=E10_E64/E10_T
E10_R65=E10_E65/E10_T
E10_R66=E10_E66/E10_T
E10_ES=E10_E61+E10_E62+E10_E63+E10_E64+E10_E65+E10_E66
E10_RS=E10_ES/E10_T
*CFOPEN,e10_section_modal_sene,csv,,APPEND
*VWRITE,E10_I,E10_T,E10_E61,E10_E62,E10_E63,E10_E64,E10_E65,E10_E66,E10_R61,E10_R62,E10_R63,E10_R64,E10_R65,E10_R66,E10_ES,E10_RS
(F8.0,15(',',E24.16))
*CFCLOS
ALLSEL,ALL
ESEL,S,TYPE,,4
SSUM
*GET,E10_T4E,SSUM,0,ITEM,S10SENE
ESEL,S,TYPE,,6
SSUM
*GET,E10_T6E,SSUM,0,ITEM,S10SENE
ESEL,S,TYPE,,70
SSUM
*GET,E10_T70E,SSUM,0,ITEM,S10SENE
E10_RT4=E10_T4E/E10_T
E10_RT6=E10_T6E/E10_T
E10_RT70=E10_T70E/E10_T
*CFOPEN,e10_modal_sene_groups,csv,,APPEND
*VWRITE,E10_I,E10_T,E10_T4E,E10_T6E,E10_T70E,E10_E61,E10_E62,E10_ES,E10_RT4,E10_RT6,E10_RT70,E10_R61,E10_R62,E10_RS
(F8.0,13(',',E24.16))
*CFCLOS
ALLSEL,ALL
*ENDDO

*CFOPEN,e10_mode_probes,csv
*DO,E10_I,1,E10_ENERGY
SET,1,E10_I
*GET,E10_F,ACTIVE,0,SET,FREQ
*DO,E10_K,1,10
E10_NID=E10_PN(E10_K)
E10_UX=0
E10_UY=0
E10_UZ=0
E10_RX=0
E10_RY=0
E10_RZ=0
*IF,E10_NID,GT,0,THEN
*GET,E10_UX,NODE,E10_NID,U,X
*GET,E10_UY,NODE,E10_NID,U,Y
*GET,E10_UZ,NODE,E10_NID,U,Z
*GET,E10_RX,NODE,E10_NID,ROT,X
*GET,E10_RY,NODE,E10_NID,ROT,Y
*GET,E10_RZ,NODE,E10_NID,ROT,Z
*ENDIF
*VWRITE,E10_I,E10_F,E10_K,E10_NID,E10_UX,E10_UY,E10_UZ,E10_RX,E10_RY,E10_RZ
(F8.0,',',E24.16,',',F8.0,',',F12.0,6(',',E24.16))
*ENDDO
E10_GUX=0
E10_GUY=0
E10_GUZ=0
E10_GRX=0
E10_GRY=0
E10_GRZ=0
*IF,E10_GP,GT,0,THEN
*GET,E10_GUX,NODE,E10_GP,U,X
*GET,E10_GUY,NODE,E10_GP,U,Y
*GET,E10_GUZ,NODE,E10_GP,U,Z
*GET,E10_GRX,NODE,E10_GP,ROT,X
*GET,E10_GRY,NODE,E10_GP,ROT,Y
*GET,E10_GRZ,NODE,E10_GP,ROT,Z
*ENDIF
*VWRITE,E10_I,E10_F,11,E10_GP,E10_GUX,E10_GUY,E10_GUZ,E10_GRX,E10_GRY,E10_GRZ
(F8.0,',',E24.16,',',F8.0,',',F12.0,6(',',E24.16))
*ENDDO
*CFCLOS
/GOPR

! Static RST: force and moment resultants at UZ supports (N15 global equilibrium).
FILE,cw_E10_0827t125824,rst
SET,LAST
ALLSEL,ALL
NSEL,S,D,UZ
FSUM
*GET,E10_FX,FSUM,0,ITEM,FX
*GET,E10_FY,FSUM,0,ITEM,FY
*GET,E10_FZ,FSUM,0,ITEM,FZ
*GET,E10_MX,FSUM,0,ITEM,MX
*GET,E10_MY,FSUM,0,ITEM,MY
*GET,E10_MZ,FSUM,0,ITEM,MZ
ALLSEL,ALL
/OUTPUT,e10_static_fsum_uz_supports,txt
*VWRITE,E10_FX,E10_FY,E10_FZ
('FX=',E24.16,', FY=',E24.16,', FZ=',E24.16)
*VWRITE,E10_MX,E10_MY,E10_MZ
('MX=',E24.16,', MY=',E24.16,', MZ=',E24.16)
/OUTPUT
ALLSEL,ALL
SAVE,cw_E10_0827t125824_modal,db
/OUTPUT,e10_gate_status,txt
/COM,STATUS=SOLVER_EXPORT_COMPLETED PHASE=POST1_CONTINUE
/OUTPUT
FINISH
/EXIT,NOSAVE
