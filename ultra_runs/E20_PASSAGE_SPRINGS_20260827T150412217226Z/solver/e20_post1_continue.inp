! D10 POST1 recovery: read existing RSTP, do not re-solve.
! Skip 80 x full-model PRNSOL (that is why the original POST1 never finished).
! PFACT/EFFM may read as 0 after RESUME of the static eq.db; SENE+probes are the pairing evidence.
FINISH
/FILNAME,cw_E20_0827t150412,1
/NERR,100000,100000
/POST1
FILE,cw_E20_0827t150412,rstp
SET,LAST
*GET,E20_AVAILABLE,ACTIVE,0,SET,NSET
E20_REQUESTED=80
*IF,E20_AVAILABLE,LT,20,THEN
/OUTPUT,e20_gate_status,txt
/COM,STATUS=REJECTED REASON=MODAL_RESULT_COUNT_MISMATCH
/OUTPUT
/EXIT,NOSAVE
*ENDIF
E20_EXPORTED=E20_AVAILABLE
/OUTPUT,e20_modal_export_manifest,txt
*VWRITE,E20_REQUESTED,E20_AVAILABLE,E20_EXPORTED
('REQUESTED=',F12.0,', AVAILABLE=',F12.0,', EXPORTED=',F12.0)
/OUTPUT
/OUTPUT,e20_modal_set_list,txt
SET,LIST
/OUTPUT
/NOPR
*CFOPEN,e20_modal_properties,csv
*DO,E20_I,1,E20_EXPORTED
SET,1,E20_I
*GET,E20_F,ACTIVE,0,SET,FREQ
E20_G=0
E20_PX=0
E20_PY=0
E20_PZ=0
E20_PRX=0
E20_PRY=0
E20_PRZ=0
E20_EX=0
E20_EY=0
E20_EZ=0
E20_ERX=0
E20_ERY=0
E20_ERZ=0
*GET,E20_G,MODE,E20_I,GENM
*GET,E20_PX,MODE,E20_I,PFACT,,DIREC,X
*GET,E20_PY,MODE,E20_I,PFACT,,DIREC,Y
*GET,E20_PZ,MODE,E20_I,PFACT,,DIREC,Z
*GET,E20_PRX,MODE,E20_I,PFACT,,DIREC,ROTX
*GET,E20_PRY,MODE,E20_I,PFACT,,DIREC,ROTY
*GET,E20_PRZ,MODE,E20_I,PFACT,,DIREC,ROTZ
*GET,E20_EX,MODE,E20_I,EFFM,,DIREC,X
*GET,E20_EY,MODE,E20_I,EFFM,,DIREC,Y
*GET,E20_EZ,MODE,E20_I,EFFM,,DIREC,Z
*GET,E20_ERX,MODE,E20_I,EFFM,,DIREC,ROTX
*GET,E20_ERY,MODE,E20_I,EFFM,,DIREC,ROTY
*GET,E20_ERZ,MODE,E20_I,EFFM,,DIREC,ROTZ
*VWRITE,E20_I,E20_F,E20_G,E20_PX,E20_PY,E20_PZ,E20_PRX,E20_PRY,E20_PRZ,E20_EX,E20_EY,E20_EZ,E20_ERX,E20_ERY,E20_ERZ
(F8.0,14(',',E24.16))
*ENDDO
*CFCLOS
/GOPR
FINISH
RESUME,cw_E20_0827t150412_eq,db
/POST1
FILE,cw_E20_0827t150412,rstp
SET,LAST
*GET,E20_EXPORTED,ACTIVE,0,SET,NSET
*IF,E20_EXPORTED,LT,20,THEN
/OUTPUT,e20_gate_status,txt
/COM,STATUS=REJECTED REASON=MODAL_RESULT_COUNT_MISMATCH
/OUTPUT
/EXIT,NOSAVE
*ENDIF
! Last RSTP set may be interrupted during MXPAND element output (C20: Mode 51).
E20_ENERGY=E20_EXPORTED
*IF,E20_EXPORTED,GE,51,THEN
E20_ENERGY=50
*ENDIF
/NERR,100000,100000

! Station probes on TYPE4 (cables): two catwalks at five X stations.
! X mm: north side, Q1, mid, Q3, south side.
E20_XS1=372853
E20_XS2=1272409
E20_XS3=1847909
E20_XS4=2423409
E20_XS5=3361547
*DIM,E20_PN,,10
*DO,E20_K,1,5
*IF,E20_K,EQ,1,THEN
E20_XS=E20_XS1
*ENDIF
*IF,E20_K,EQ,2,THEN
E20_XS=E20_XS2
*ENDIF
*IF,E20_K,EQ,3,THEN
E20_XS=E20_XS3
*ENDIF
*IF,E20_K,EQ,4,THEN
E20_XS=E20_XS4
*ENDIF
*IF,E20_K,EQ,5,THEN
E20_XS=E20_XS5
*ENDIF
ALLSEL,ALL
ESEL,S,TYPE,,4
NSLE,S
NSEL,R,LOC,X,E20_XS-1500,E20_XS+1500
NSEL,R,LOC,Y,18000,25000
*GET,E20_NC,NODE,0,COUNT
E20_NID=0
*IF,E20_NC,GT,0,THEN
*GET,E20_NID,NODE,0,NUM,MIN
*ENDIF
E20_PN(E20_K)=E20_NID
ALLSEL,ALL
ESEL,S,TYPE,,4
NSLE,S
NSEL,R,LOC,X,E20_XS-1500,E20_XS+1500
NSEL,R,LOC,Y,-25000,-18000
*GET,E20_NC,NODE,0,COUNT
E20_NID=0
*IF,E20_NC,GT,0,THEN
*GET,E20_NID,NODE,0,NUM,MIN
*ENDIF
E20_PN(E20_K+5)=E20_NID
*ENDDO
ALLSEL,ALL
CMSEL,S,GATE_TOPPOST_E
NSLE,S
*GET,E20_NC,NODE,0,COUNT
E20_GP=0
*IF,E20_NC,GT,0,THEN
*GET,E20_GP,NODE,0,NUM,MIN
*ENDIF
ALLSEL,ALL
/OUTPUT,e20_probe_nodes,txt
*VWRITE,E20_PN(1),E20_PN(2),E20_PN(3),E20_PN(4),E20_PN(5),E20_PN(6),E20_PN(7),E20_PN(8),E20_PN(9),E20_PN(10),E20_GP
('P+',5F12.0,/,'P-',5F12.0,/,'GATE_TOPPOST_NODE=',F12.0)
/OUTPUT

*DO,E20_I,1,E20_ENERGY
SET,1,E20_I
ALLSEL,ALL
ETABLE,ERAS
ETABLE,S10SENE,SENE
SSUM
*GET,E20_T,SSUM,0,ITEM,S10SENE
*IF,E20_T,LE,0,THEN
E20_T=1.0E-30
*ENDIF
CMSEL,S,GATE_BOTTOM_E
SSUM
*GET,E20_E61,SSUM,0,ITEM,S10SENE
CMSEL,S,GATE_TOPPOST_E
SSUM
*GET,E20_E62,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_CHORD152_E
SSUM
*GET,E20_E63,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_FRAME102_E
SSUM
*GET,E20_E64,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_BRACE51_E
SSUM
*GET,E20_E65,SSUM,0,ITEM,S10SENE
CMSEL,S,PASS_RHS5030_E
SSUM
*GET,E20_E66,SSUM,0,ITEM,S10SENE
E20_R61=E20_E61/E20_T
E20_R62=E20_E62/E20_T
E20_R63=E20_E63/E20_T
E20_R64=E20_E64/E20_T
E20_R65=E20_E65/E20_T
E20_R66=E20_E66/E20_T
E20_ES=E20_E61+E20_E62+E20_E63+E20_E64+E20_E65+E20_E66
E20_RS=E20_ES/E20_T
*CFOPEN,e20_section_modal_sene,csv,,APPEND
*VWRITE,E20_I,E20_T,E20_E61,E20_E62,E20_E63,E20_E64,E20_E65,E20_E66,E20_R61,E20_R62,E20_R63,E20_R64,E20_R65,E20_R66,E20_ES,E20_RS
(F8.0,15(',',E24.16))
*CFCLOS
ALLSEL,ALL
ESEL,S,TYPE,,4
SSUM
*GET,E20_T4E,SSUM,0,ITEM,S10SENE
ESEL,S,TYPE,,6
SSUM
*GET,E20_T6E,SSUM,0,ITEM,S10SENE
ESEL,S,TYPE,,70
SSUM
*GET,E20_T70E,SSUM,0,ITEM,S10SENE
E20_RT4=E20_T4E/E20_T
E20_RT6=E20_T6E/E20_T
E20_RT70=E20_T70E/E20_T
*CFOPEN,e20_modal_sene_groups,csv,,APPEND
*VWRITE,E20_I,E20_T,E20_T4E,E20_T6E,E20_T70E,E20_E61,E20_E62,E20_ES,E20_RT4,E20_RT6,E20_RT70,E20_R61,E20_R62,E20_RS
(F8.0,13(',',E24.16))
*CFCLOS
ALLSEL,ALL
*ENDDO

*CFOPEN,e20_mode_probes,csv
*DO,E20_I,1,E20_ENERGY
SET,1,E20_I
*GET,E20_F,ACTIVE,0,SET,FREQ
*DO,E20_K,1,10
E20_NID=E20_PN(E20_K)
E20_UX=0
E20_UY=0
E20_UZ=0
E20_RX=0
E20_RY=0
E20_RZ=0
*IF,E20_NID,GT,0,THEN
*GET,E20_UX,NODE,E20_NID,U,X
*GET,E20_UY,NODE,E20_NID,U,Y
*GET,E20_UZ,NODE,E20_NID,U,Z
*GET,E20_RX,NODE,E20_NID,ROT,X
*GET,E20_RY,NODE,E20_NID,ROT,Y
*GET,E20_RZ,NODE,E20_NID,ROT,Z
*ENDIF
*VWRITE,E20_I,E20_F,E20_K,E20_NID,E20_UX,E20_UY,E20_UZ,E20_RX,E20_RY,E20_RZ
(F8.0,',',E24.16,',',F8.0,',',F12.0,6(',',E24.16))
*ENDDO
E20_GUX=0
E20_GUY=0
E20_GUZ=0
E20_GRX=0
E20_GRY=0
E20_GRZ=0
*IF,E20_GP,GT,0,THEN
*GET,E20_GUX,NODE,E20_GP,U,X
*GET,E20_GUY,NODE,E20_GP,U,Y
*GET,E20_GUZ,NODE,E20_GP,U,Z
*GET,E20_GRX,NODE,E20_GP,ROT,X
*GET,E20_GRY,NODE,E20_GP,ROT,Y
*GET,E20_GRZ,NODE,E20_GP,ROT,Z
*ENDIF
*VWRITE,E20_I,E20_F,11,E20_GP,E20_GUX,E20_GUY,E20_GUZ,E20_GRX,E20_GRY,E20_GRZ
(F8.0,',',E24.16,',',F8.0,',',F12.0,6(',',E24.16))
*ENDDO
*CFCLOS
/GOPR

! Static RST: force and moment resultants at UZ supports (N15 global equilibrium).
FILE,cw_E20_0827t150412,rst
SET,LAST
ALLSEL,ALL
NSEL,S,D,UZ
FSUM
*GET,E20_FX,FSUM,0,ITEM,FX
*GET,E20_FY,FSUM,0,ITEM,FY
*GET,E20_FZ,FSUM,0,ITEM,FZ
*GET,E20_MX,FSUM,0,ITEM,MX
*GET,E20_MY,FSUM,0,ITEM,MY
*GET,E20_MZ,FSUM,0,ITEM,MZ
ALLSEL,ALL
/OUTPUT,e20_static_fsum_uz_supports,txt
*VWRITE,E20_FX,E20_FY,E20_FZ
('FX=',E24.16,', FY=',E24.16,', FZ=',E24.16)
*VWRITE,E20_MX,E20_MY,E20_MZ
('MX=',E24.16,', MY=',E24.16,', MZ=',E24.16)
/OUTPUT
ALLSEL,ALL
SAVE,cw_E20_0827t150412_modal,db
