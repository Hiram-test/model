    "N15": {"skill": "bridge-solution-verification", "gate": "G13", "criteriaCount": 10, "requiredUpstreamGates": ["G12"], "requiredApprovals": [], "requiredArtifacts": ["solution_verification_report.json", "verified_result_set.json", "global_equilibrium_report.json", "substructure_free_body_report.json", "mesh_and_step_convergence_report.json", "solver_warning_disposition.json", "solution_issues.json"]},
