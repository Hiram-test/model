{
  "policyVersion": "1.0.0",
  "workflowId": "bridge-fem-static-review",
  "stateFile": ".bridge-fem/current.json",
  "runRoot": ".bridge-fem/runs",
  "auditRoot": ".bridge-fem/audit",
  "formalPolicy": {
    "solverEntryNode": "N14",
    "strictSolverGates": ["G3", "G4", "G5", "G6", "G7", "G8A", "G8B", "G9", "G10", "G11"],
    "solverPrerequisiteGates": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8A", "G8B", "G9", "G10", "G11"],
    "conditionalNotApplicableGates": ["G8B"],
    "solutionEntryGates": ["G12"],
    "codeReviewEntryGates": ["G13"],
    "independentReviewEntryGates": ["G14"],
    "releaseEntryGates": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8A", "G8B", "G9", "G10", "G11", "G12", "G13", "G14", "G15"]
  },
  "approvedCommands": {
    "runControllerMarkers": ["bridge_fem_run.py init", "bridge_fem_run.py enter", "bridge_fem_run.py close", "bridge_fem_run.py status"],
    "gateEvaluatorMarkers": ["bridge_fem_gate_validator.py", "bridge-fem-gate-validator"],
    "releaseBuilderMarkers": ["bridge_fem_release.py", "bridge-fem-release-builder"]
  },
  "patterns": {
    "solverCommands": ["\\bansys\\b", "\\bmapdl\\b", "\\babaqus\\b", "\\bmidas\\b", "\\bsap2000\\b", "\\bopensees\\b", "\\bsofistik\\b", "\\bcalculix\\b", "\\bccx\\b", "solver[_-]?(run|execute|deck)"],
    "solverDeckWrites": ["solver[_-]?deck", "\\.(inp|cdb|dat|mac|tcl|mct)(?:\\s|$|\")"],
    "rawResultPaths": ["raw[_-]?result", "\\.(rst|rth|rmg|mode|full|odb|op2|h3d)(?:\\s|$|\")"],
    "releaseWrites": ["release_manifest", "machine_release_bundle", "engineering_report_data", "approval_and_signature_record", "release_validation_report", "(?:^|[/\\\\])release[/\\\\]"],
    "gateStateWrites": ["gate[_-]?ledger", "gate[_-]?receipt", "gate-receipts", "computedStatus"],
    "runStateWrites": ["\\.bridge-fem[/\\\\]current\\.json", "\\.bridge-fem[/\\\\]runs"],
    "completionClaims": ["(?:N(?:0[0-9]|1[0-8]))[^\\n]{0,50}(?:完成|已执行|PASS|通过)", "(?:G(?:-ORCH|[0-9]+[A-Z]?))[^\\n]{0,50}(?:PASS|通过)", "(?:求解|solver)[^\\n]{0,50}(?:完成|成功|通过)", "(?:验证|复核)[^\\n]{0,50}(?:完成|通过)", "(?:发布|release)[^\\n]{0,50}(?:完成|通过|可用)", "19\\s*/\\s*19", "十九个\\s*Skill"]
  },
